extends main.pug

block sidebar
  block sidebar

block content
  div(class="max-w-6xl mx-auto space-y-6")
    div(class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4")
      div
        h1(class="text-2xl font-bold text-slate-900")
          block crud_title
        p(class="text-sm text-slate-500 mt-1")
          block crud_subtitle
      
      div(class="flex items-center gap-3")
        block crud_search
          // Search form
          form(method="GET" action=searchActionUrl class="relative flex items-center")
            if currentQuery
              each val, key in currentQuery
                if key !== 'search' && key !== 'page'
                  input(type="hidden" name=key value=val)
            svg(xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
            input(type="text" name="search" placeholder=(searchPlaceholder || "Cari...") value=(pagination && pagination.search ? pagination.search : (currentQuery && currentQuery.search ? currentQuery.search : '')) class="pl-9 pr-4 py-2 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 text-sm w-full sm:w-64")
            button(type="submit" class="hidden") Cari
        
        block crud_create_button

    div(class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden")
      div(class="overflow-x-auto")
        table(class="w-full text-left border-collapse")
          thead
            tr(class="bg-slate-50 border-b border-slate-200")
              block crud_table_headers
          tbody(class="divide-y divide-slate-200")
            block crud_table_rows
      
      // Generic pagination footer
      if pagination && pagination.totalPages > 1
        div(class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between")
          p(class="text-sm text-slate-500") Menampilkan #{pagination.startIndex} hingga #{pagination.endIndex} dari #{pagination.totalItems} data
          - 
            var getPageUrl = function(pageNum) {
              var q = Object.assign({}, currentQuery || {});
              q.page = pageNum;
              var params = [];
              for(var k in q) {
                if(q[k] !== undefined && q[k] !== '') params.push(encodeURIComponent(k) + '=' + encodeURIComponent(q[k]));
              }
              return searchActionUrl + (params.length ? '?' + params.join('&') : '');
            }
          div(class="flex gap-1")
            // Previous button
            if pagination.hasPrevPage
              a(href=getPageUrl(pagination.currentPage - 1) class="px-3 py-1 text-sm border border-slate-300 rounded text-slate-700 bg-white hover:bg-slate-50 transition-colors") Sblm
            else
              span(class="px-3 py-1 text-sm border border-slate-200 rounded text-slate-400 bg-slate-50 cursor-not-allowed") Sblm

            // Page numbers
            each p in pagination.pages
              if p === pagination.currentPage
                span(class="px-3 py-1 text-sm border border-green-600 rounded text-white bg-green-600 font-medium")= p
              else
                a(href=getPageUrl(p) class="px-3 py-1 text-sm border border-slate-300 rounded text-slate-700 bg-white hover:bg-slate-50 transition-colors")= p

            // Next button
            if pagination.hasNextPage
              a(href=getPageUrl(pagination.currentPage + 1) class="px-3 py-1 text-sm border border-slate-300 rounded text-slate-700 bg-white hover:bg-slate-50 transition-colors") Lanjut
            else
              span(class="px-3 py-1 text-sm border border-slate-200 rounded text-slate-400 bg-slate-50 cursor-not-allowed") Lanjut
      else if pagination && pagination.totalItems > 0
        div(class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between")
          p(class="text-sm text-slate-500") Menampilkan 1 hingga #{pagination.totalItems} dari #{pagination.totalItems} data
      else
        div(class="px-6 py-8 text-center text-slate-500 bg-white")
          p Tidak ada data yang ditemukan.
