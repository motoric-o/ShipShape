extends main.pug

block sidebar
  block sidebar

block content
  div(class="max-w-4xl mx-auto space-y-6")
    div(class="flex items-center gap-3")
      a(href=backUrl class="text-slate-400 hover:text-slate-600 transition-colors")
        svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18")
      div
        h1(class="text-2xl font-bold text-slate-900")
          block crud_form_title
        p(class="text-sm text-slate-500 mt-1")
          block crud_form_subtitle
    
    form(action=actionUrl method="POST" class="space-y-6 bg-white p-6 md:p-8 rounded-xl shadow-sm border border-slate-200" id=formId || "crud-form" onsubmit=onSubmitJs || "")
      if isPut
        input(type="hidden" name="_method" value="PUT")
      
      if currentQuery && currentQuery.error
        div(class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 text-sm font-medium rounded-xl flex items-center gap-3 animate-pulse")
          svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z")
          span= currentQuery.error

      block crud_form_fields
          
      div(class="flex items-center justify-end space-x-3 pt-4 mt-6 border-t border-slate-100")
        a(href=backUrl class="px-5 py-2.5 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors") Batal
        button(type="submit" class="px-5 py-2.5 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 transition-colors shadow-sm")
          block crud_form_submit_label
