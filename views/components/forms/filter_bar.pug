mixin filterBar(actionUrl, placeholder, isAdvancedOpened, resetUrl, hasActiveFilters, sortOptions = null, selectedSort = '', gridCols = '')
  - const showPanel = isAdvancedOpened
  - const computedGridCols = gridCols ? gridCols : (sortOptions ? 'grid-cols-1 sm:grid-cols-2 md:grid-cols-4' : 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3')

  div(class="w-full")
    form(method="GET" action=actionUrl class="space-y-3")
      div(class="flex flex-col sm:flex-row items-center gap-3 w-full")
        //- Search Input
        div(class="relative w-full sm:flex-1")
          svg(xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
          input(type="text" name="search" placeholder=placeholder value=(pagination && pagination.search ? pagination.search : (currentQuery && currentQuery.search ? currentQuery.search : '')) class="pl-9 pr-4 py-2 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 text-sm w-full")
        
        //- Buttons Row
        div(class="flex items-center gap-2 w-full sm:w-auto shrink-0")
          button(type="button" id="toggle-advanced" class="flex items-center justify-center gap-2 px-4 py-2 bg-white border border-slate-300 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors shadow-sm cursor-pointer")
            svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4")
            span Sort &amp; Filter
            svg(id="toggle-chevron" xmlns="http://www.w3.org/2000/svg" class=`h-4 w-4 text-slate-400 transition-transform duration-200 ${showPanel ? 'rotate-180' : ''}` fill="none" viewBox="0 0 24 24" stroke="currentColor")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7")
          
          button(type="submit" class="px-5 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg text-sm font-medium transition-colors shadow-sm cursor-pointer") Cari
          
          if hasActiveFilters || (pagination && pagination.search)
            a(href=resetUrl class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-sm font-medium transition-colors shadow-sm flex items-center justify-center" title="Reset Filter")
              svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2")
                path(stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99")

      //- Advanced Filters Panel
      div(id="advanced-filters-panel" class=`transition-all duration-300 ease-in-out border border-slate-200 rounded-xl p-4 bg-slate-50/50 mt-3 ${showPanel ? 'block opacity-100' : 'hidden opacity-0'}`)
        div(class=`grid ${computedGridCols} gap-4`)
          block

          if sortOptions && sortOptions.length > 0
            div(class="space-y-1.5")
              label(class="text-xs font-semibold text-slate-500 uppercase tracking-wider") Urutkan
              +selectField("sortBy", "sortBy", null, sortOptions, selectedSort || 'latest', false, "py-2 pl-3 pr-10 bg-white min-w-full")

  script.
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('toggle-advanced');
      const panel = document.getElementById('advanced-filters-panel');
      const chevron = document.getElementById('toggle-chevron');
      if (btn && panel && chevron) {
        btn.addEventListener('click', () => {
          if (panel.classList.contains('hidden')) {
            panel.classList.remove('hidden');
            setTimeout(() => {
              panel.classList.remove('opacity-0');
              panel.classList.add('opacity-100');
            }, 10);
            chevron.classList.add('rotate-180');
          } else {
            panel.classList.remove('opacity-100');
            panel.classList.add('opacity-0');
            setTimeout(() => {
              panel.classList.add('hidden');
            }, 300);
            chevron.classList.remove('rotate-180');
          }
        });
      }
    });
