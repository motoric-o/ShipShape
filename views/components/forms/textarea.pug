mixin textareaField(id, name, label, value = '', placeholder = '', rows = 4, required = false, extraClasses = '')
  div(class="space-y-2")
    label(for=id class="text-sm font-medium text-slate-700")= label
    textarea(
      id=id
      name=name
      rows=rows
      placeholder=placeholder
      required=required
      class=`w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 transition-colors ${extraClasses}`
    )= value
