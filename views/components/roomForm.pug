mixin roomForm(room = {}, actionUrl = "/rooms", method = "POST")
  form(action=actionUrl method="POST" class="space-y-6 bg-white p-6 md:p-8 rounded-xl shadow-sm border border-slate-200")
    if method === "PUT"
      input(type="hidden" name="_method" value="PUT")
    
    div(class="space-y-4")
      div(class="space-y-2")
        label(for="name" class="text-sm font-medium text-slate-700") Nama Ruangan
        input#name(type="text" name="name" value=room.name || '' placeholder="Lab Komputer 1" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 transition-colors" required)
      
      div(class="space-y-2")
        label(for="description" class="text-sm font-medium text-slate-700") Deskripsi (Opsional)
        textarea#description(name="description" rows="4" placeholder="Deskripsi atau fungsi ruangan ini..." class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 transition-colors")= room.description || ''
          
    div(class="flex items-center justify-end space-x-3 pt-4 mt-6 border-t border-slate-100")
      a(href="/rooms" class="px-5 py-2.5 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors") Batal
      button(type="submit" class="px-5 py-2.5 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 transition-colors shadow-sm") Simpan Ruangan
