mixin userForm(user = {}, actionUrl = "/users", method = "POST")
  form(action=actionUrl method="POST" class="space-y-6 bg-white p-6 md:p-8 rounded-xl shadow-sm border border-slate-200")
    if method === "PUT"
      input(type="hidden" name="_method" value="PUT")
    
    div(class="grid grid-cols-1 md:grid-cols-2 gap-6")
      div(class="space-y-2")
        label(for="name" class="text-sm font-medium text-slate-700") Full Name
        input#name(type="text" name="name" value=user.name || '' placeholder="John Doe" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 transition-colors" required)
      
      div(class="space-y-2")
        label(for="email" class="text-sm font-medium text-slate-700") Email Address
        input#email(type="email" name="email" value=user.email || '' placeholder="john@example.com" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 transition-colors" required)
      
      div(class="space-y-2")
        label(for="role" class="text-sm font-medium text-slate-700") Role
        select#role(name="role" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 transition-colors bg-white")
          option(value="STAF_LAB" selected=(user.role === 'STAF_LAB')) Staf Laboratorium
          option(value="STAF_ADMIN" selected=(user.role === 'STAF_ADMIN')) Staf Administrasi
          option(value="KALAB" selected=(user.role === 'KALAB')) Kepala Laboratorium
          option(value="KAPRODI" selected=(user.role === 'KAPRODI')) Ketua Program Studi
          option(value="ADMIN" selected=(user.role === 'ADMIN')) Administrator
      
      div(class="space-y-2")
        label(for="password" class="text-sm font-medium text-slate-700") Password
        if user.id
          input#password(type="password" name="password" placeholder="Leave blank to keep current" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 transition-colors")
        else
          input#password(type="password" name="password" placeholder="••••••••" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 transition-colors" required)
          
    div(class="flex items-center justify-end space-x-3 pt-4 mt-6 border-t border-slate-100")
      a(href="/users" class="px-5 py-2.5 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors") Cancel
      button(type="submit" class="px-5 py-2.5 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 transition-colors shadow-sm") Save User
