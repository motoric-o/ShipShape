aside(class="w-64 lg:w-72 h-full bg-white border-r border-slate-200/80 flex flex-col shadow-[4px_0_24px_rgba(0,0,0,0.02)] shrink-0")
  nav(class="flex-1 py-8 px-4 space-y-1.5 overflow-y-auto")
    p(class="px-4 text-xs font-bold uppercase tracking-wider text-slate-400 mb-4") Menu Utama
    
    mixin navItem(href, label, iconPath1, iconPath2, activePaths)
      - var isActive = activePaths.some(p => currentPath === p || (p !== '/' && currentPath && currentPath.startsWith(p + '/')))
      a(href=href class=`flex items-center gap-3 px-4 py-3 rounded-xl transition-all ${isActive ? 'bg-green-50 text-green-800 font-semibold border border-green-100/50 shadow-sm' : 'text-slate-600 font-medium hover:bg-slate-50 hover:text-slate-900 duration-200 hover:shadow-[0_2px_8px_rgba(0,0,0,0.04)] group'}`)
        div(class=`w-8 h-8 rounded-lg flex items-center justify-center transition-all ${isActive ? 'bg-green-100 text-green-700' : 'bg-slate-50 text-slate-400 group-hover:bg-white group-hover:text-orange-600 group-hover:shadow-sm'}`)
          svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            if iconPath1
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width=isActive ? "2.5" : "2" d=iconPath1)
            if iconPath2
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width=isActive ? "2.5" : "2" d=iconPath2)
        span= label

