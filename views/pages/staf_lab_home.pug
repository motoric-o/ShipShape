extends ../layouts/main.pug

block sidebar
  include ../components/sidebars/staf_lab.pug

block content
  div(class="max-w-7xl mx-auto")
    //- Hero Header Section
    div(class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4")
      div
        div(class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-slate-200 shadow-sm mb-4")
          span(class="w-2 h-2 rounded-full bg-orange-500 animate-pulse")
          span(class="text-xs font-bold tracking-wide text-slate-600 uppercase") Field Operations
        h2(class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900") Good morning, Staf Lab
        p(class="text-slate-500 mt-2 text-lg font-medium") Here is the current stock and maintenance status.
      div(class="flex items-center gap-3")
        button(class="px-4 py-2.5 bg-slate-900 rounded-xl text-sm font-semibold text-white shadow-md shadow-slate-900/20 hover:bg-green-700 hover:shadow-green-700/20 transition-all duration-300 hover:-translate-y-0.5") Log Maintenance
    
    //- Fluid Metric Cards Grid
    div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6")
      
      //- Card 1
      div(class="group rounded-2xl border border-slate-200/60 bg-white/80 backdrop-blur-sm p-6 shadow-sm transition-all duration-300 hover:shadow-xl hover:shadow-slate-200/50 hover:-translate-y-1 relative overflow-hidden")
        div(class="absolute top-0 right-0 w-32 h-32 bg-orange-500/5 rounded-full blur-3xl -mr-10 -mt-10 transition-all duration-500 group-hover:bg-orange-500/10")
        div(class="flex justify-between items-start mb-6 relative z-10")
          div(class="w-12 h-12 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center shadow-sm group-hover:bg-orange-50 group-hover:border-orange-100 transition-colors")
            svg(class="w-6 h-6 text-slate-600 group-hover:text-orange-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z")
          span(class="inline-flex items-center rounded-full bg-orange-50 px-2.5 py-0.5 text-xs font-bold text-orange-700 border border-orange-200/60") Depleted
        div(class="relative z-10")
          h3(class="text-slate-500 font-semibold text-sm mb-1") Critical BHP Shortages
          div(class="flex items-baseline gap-2")
            p(class="text-4xl font-extrabold tracking-tight text-slate-900") 18
            span(class="text-sm font-medium text-slate-400") items
            
      //- Card 2
      div(class="group rounded-2xl border border-slate-200/60 bg-white/80 backdrop-blur-sm p-6 shadow-sm transition-all duration-300 hover:shadow-xl hover:shadow-slate-200/50 hover:-translate-y-1 relative overflow-hidden")
        div(class="absolute top-0 right-0 w-32 h-32 bg-slate-500/5 rounded-full blur-3xl -mr-10 -mt-10 transition-all duration-500 group-hover:bg-slate-500/10")
        div(class="flex justify-between items-start mb-6 relative z-10")
          div(class="w-12 h-12 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center shadow-sm group-hover:bg-slate-100 group-hover:border-slate-200 transition-colors")
            svg(class="w-6 h-6 text-slate-600 group-hover:text-slate-900 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
          span(class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-bold text-slate-600 border border-slate-200") This Week
        div(class="relative z-10")
          h3(class="text-slate-500 font-semibold text-sm mb-1") Scheduled Maintenance
          div(class="flex items-baseline gap-2")
            p(class="text-4xl font-extrabold tracking-tight text-slate-900") 4
            span(class="text-sm font-medium text-slate-400") tickets
            
      //- Card 3
      div(class="group rounded-2xl border border-slate-200/60 bg-white/80 backdrop-blur-sm p-6 shadow-sm transition-all duration-300 hover:shadow-xl hover:shadow-slate-200/50 hover:-translate-y-1 relative overflow-hidden")
        div(class="absolute top-0 right-0 w-32 h-32 bg-green-500/5 rounded-full blur-3xl -mr-10 -mt-10 transition-all duration-500 group-hover:bg-green-500/10")
        div(class="flex justify-between items-start mb-6 relative z-10")
          div(class="w-12 h-12 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center shadow-sm group-hover:bg-green-50 group-hover:border-green-100 transition-colors")
            svg(class="w-6 h-6 text-slate-600 group-hover:text-green-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7")
          span(class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-bold text-green-700 border border-green-200/60") Complete
        div(class="relative z-10")
          h3(class="text-slate-500 font-semibold text-sm mb-1") Assets Serviced
          div(class="flex items-baseline gap-2")
            p(class="text-4xl font-extrabold tracking-tight text-slate-900") 12
            span(class="text-sm font-medium text-slate-400") this cycle
