extends ../../layouts/main.pug

block sidebar
  if sessionUser && sessionUser.userRole === 'ADMIN'
    include ../../components/sidebars/admin.pug
  else if sessionUser && sessionUser.userRole === 'KAPRODI'
    include ../../components/sidebars/kaprodi.pug
  else if sessionUser && sessionUser.userRole === 'KALAB'
    include ../../components/sidebars/kepala_lab.pug
  else if sessionUser && sessionUser.userRole === 'STAF_ADMIN'
    include ../../components/sidebars/staf_admin.pug
  else if sessionUser && sessionUser.userRole === 'STAF_LAB'
    include ../../components/sidebars/staf_lab.pug

block content
  div(class="max-w-xl mx-auto space-y-6 pb-12")
    //- Breadcrumb & Title Section
    div(class="mb-8 flex flex-col items-center text-center gap-2")
      div(class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-slate-200 shadow-sm mb-2")
        span(class="w-2 h-2 rounded-full bg-green-500 animate-pulse")
        span(class="text-xs font-bold tracking-wide text-slate-600 uppercase") Scan Aset
      h1(class="text-3xl font-extrabold tracking-tight text-slate-900") QR Scanner
      p(class="text-slate-500 text-sm font-medium") Pindai QR Code sistem untuk membuka detail aset secara otomatis.

    //- Scanner Container Card
    div(class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col")
      
      //- Camera Selection Header
      div(class="p-5 border-b border-slate-100 bg-slate-50/50 flex flex-col gap-4")
        div(class="flex items-center gap-3")
          div(class="w-10 h-10 rounded-xl bg-green-100 flex items-center justify-center text-green-700 shrink-0")
            svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z")
          div
            h3(class="text-sm font-bold text-slate-800") Pilih Kamera
            p(class="text-xs text-slate-400 font-medium") Tentukan perangkat kamera input Anda.
        
        div(class="flex flex-col sm:flex-row gap-3 w-full")
          select#camera-select(class="flex-grow text-sm font-medium border border-slate-200 rounded-xl px-4 py-2.5 bg-white text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-green-500/20 focus:border-green-500")
            option(value="") Mendeteksi kamera...
          button#toggle-btn(type="button" class="px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold rounded-xl shadow-sm transition-all duration-200 flex items-center justify-center gap-2 whitespace-nowrap focus:outline-none active:scale-98")
            svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z")
            span Mulai Scan

      //- Active Scanning View
      div(class="p-6 flex flex-col items-center justify-center bg-slate-900/5 min-h-[360px] relative")
        
        //- Scanner boundary container (Acts as a device-like frame with padding)
        div(class="relative w-full max-w-sm aspect-square bg-slate-950 rounded-3xl p-4 overflow-hidden shadow-2xl border border-slate-800 flex items-center justify-center")
          
          //- The actual html5-qrcode reader element
          div#reader(class="w-full h-full rounded-2xl overflow-hidden bg-slate-950")
          
          //- Scanner Overlay Decorators
          div#scan-decor(class="absolute inset-8 pointer-events-none flex items-center justify-center")
            //- Target Corner lines
            div(class="absolute top-0 left-0 w-8 h-8 border-t-4 border-l-4 border-green-500 rounded-tl-md")
            div(class="absolute top-0 right-0 w-8 h-8 border-t-4 border-r-4 border-green-500 rounded-tr-md")
            div(class="absolute bottom-0 left-0 w-8 h-8 border-b-4 border-l-4 border-green-500 rounded-bl-md")
            div(class="absolute bottom-0 right-0 w-8 h-8 border-b-4 border-r-4 border-green-500 rounded-br-md")
            
            //- Laser Scan Line
            div#laser-line(class="absolute left-0 right-0 h-0.5 bg-green-500/80 shadow-[0_0_12px_#22c55e] hidden")

          //- Searching Loading Overlay
          div#searching-overlay(class="absolute inset-0 bg-slate-950/80 backdrop-blur-xs flex flex-col items-center justify-center text-white transition-opacity duration-300 opacity-0 pointer-events-none z-10")
            div(class="w-10 h-10 border-4 border-green-500 border-t-transparent rounded-full animate-spin mb-4")
            p(class="text-sm font-semibold tracking-wide uppercase text-slate-300") Mencari Aset...

          //- Success Overlay
          div#success-overlay(class="absolute inset-0 bg-emerald-500/95 flex flex-col items-center justify-center text-white transition-all duration-300 opacity-0 pointer-events-none z-20 p-6 text-center")
            div(class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mb-4 border-2 border-white shadow-lg animate-bounce")
              svg(xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="3.5" d="M5 13l4 4L19 7")
            h2(class="text-xl font-black mb-1") Aset Ditemukan!
            p#success-msg(class="text-emerald-100 text-xs font-semibold") Mengalihkan ke halaman detail aset...

          //- Failure Overlay
          div#failure-overlay(class="absolute inset-0 bg-rose-500/95 flex flex-col items-center justify-center text-white transition-all duration-300 opacity-0 pointer-events-none z-20 p-6 text-center")
            div(class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mb-4 border-2 border-white shadow-lg animate-pulse")
              svg(xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12")
            h2(class="text-xl font-black mb-1") Aset Tidak Ditemukan
            p#failure-msg(class="text-rose-100 text-xs font-semibold") Label QR tidak cocok dengan item inventaris sistem.

        //- Hint / Info message below scan reader
        div(class="mt-6 flex items-center gap-2 text-slate-500 bg-slate-50 border border-slate-200/60 px-4 py-2.5 rounded-xl max-w-sm text-center w-full")
          svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z")
          p#status-hint(class="text-xs font-semibold text-slate-600 w-full text-center") Arahkan kamera Anda pada kode QR aset ShipShape.

  //- Include client-side library and logic
  script(src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js")
  script.
    document.addEventListener("DOMContentLoaded", function () {
      const cameraSelect = document.getElementById("camera-select");
      const toggleBtn = document.getElementById("toggle-btn");
      const toggleBtnText = toggleBtn.querySelector("span");
      const laserLine = document.getElementById("laser-line");
      const searchingOverlay = document.getElementById("searching-overlay");
      const successOverlay = document.getElementById("success-overlay");
      const successMsg = document.getElementById("success-msg");
      const failureOverlay = document.getElementById("failure-overlay");
      const failureMsg = document.getElementById("failure-msg");
      const statusHint = document.getElementById("status-hint");

      let html5QrCode = null;
      let isScanning = false;
      let isProcessing = false;

      // Custom CSS inject for video fit, corner frames, and focus overrides
      const style = document.createElement("style");
      style.innerHTML = `
        @keyframes laserMove {
          0% { top: 0px; opacity: 0.2; }
          50% { opacity: 1; }
          100% { top: 100%; opacity: 0.2; }
        }
        .laser-animate {
          animation: laserMove 2.5s infinite linear;
        }
        #reader video {
          width: 100% !important;
          height: 100% !important;
          object-fit: cover !important;
          border-radius: 1rem !important;
        }
        #toggle-btn:focus, #toggle-btn:active {
          outline: none !important;
          box-shadow: none !important;
        }
      `;
      document.head.appendChild(style);

      // Load Cameras on Startup
      Html5Qrcode.getCameras().then(devices => {
        cameraSelect.innerHTML = "";
        if (devices && devices.length > 0) {
          devices.forEach(device => {
            const option = document.createElement("option");
            option.value = device.id;
            option.textContent = device.label || `Kamera ${cameraSelect.options.length + 1}`;
            cameraSelect.appendChild(option);
          });
          
          // Auto-start scanning if camera is available
          startScanning();
        } else {
          showError("Kamera tidak ditemukan. Pastikan kamera terhubung dan memiliki izin.");
        }
      }).catch(err => {
        console.error("Gagal mendeteksi kamera:", err);
        showError("Izin kamera ditolak atau kamera tidak ditemukan.");
      });

      function showError(message) {
        cameraSelect.innerHTML = `<option value="">Kamera tidak tersedia</option>`;
        statusHint.textContent = message;
        statusHint.classList.add("text-rose-600");
        toggleBtn.disabled = true;
        toggleBtn.classList.add("opacity-50", "cursor-not-allowed");
      }

      function startScanning() {
        const cameraId = cameraSelect.value;
        if (!cameraId) return;

        isProcessing = false;
        
        // Hide overlays
        successOverlay.classList.add("opacity-0", "pointer-events-none");
        failureOverlay.classList.add("opacity-0", "pointer-events-none");
        searchingOverlay.classList.add("opacity-0", "pointer-events-none");

        html5QrCode = new Html5Qrcode("reader");
        
        html5QrCode.start(
          cameraId,
          {
            fps: 15,
            qrbox: function(width, height) {
              const size = Math.min(width, height) * 0.75;
              return { width: size, height: size };
            }
          },
          onScanSuccess,
          onScanError
        ).then(() => {
          isScanning = true;
          toggleBtnText.textContent = "Hentikan Scan";
          toggleBtn.classList.remove("bg-slate-900", "hover:bg-slate-800");
          toggleBtn.classList.add("bg-rose-600", "hover:bg-rose-700");
          laserLine.classList.remove("hidden");
          laserLine.classList.add("laser-animate");
          statusHint.textContent = "Scanning sedang berjalan...";
          statusHint.classList.remove("text-rose-600");
        }).catch(err => {
          console.error("Gagal memulai scanner:", err);
          statusHint.textContent = "Gagal mengakses feed kamera.";
          statusHint.classList.add("text-rose-600");
        });
      }

      function stopScanning() {
        if (!html5QrCode || !isScanning) return Promise.resolve();
        
        laserLine.classList.add("hidden");
        laserLine.classList.remove("laser-animate");

        return html5QrCode.stop().then(() => {
          isScanning = false;
          toggleBtnText.textContent = "Mulai Scan";
          toggleBtn.classList.remove("bg-rose-600", "hover:bg-rose-700");
          toggleBtn.classList.add("bg-slate-900", "hover:bg-slate-800");
          statusHint.textContent = "Scan dihentikan.";
        }).catch(err => {
          console.error("Gagal menghentikan scanner:", err);
        });
      }

      function onScanSuccess(decodedText) {
        if (isProcessing) return;
        isProcessing = true;

        // Visual feedback
        searchingOverlay.classList.remove("opacity-0", "pointer-events-none");
        searchingOverlay.classList.add("opacity-100");

        // Request check to server
        fetch(`/qr-scanner/search?label=${encodeURIComponent(decodedText)}`)
          .then(res => res.json())
          .then(data => {
            searchingOverlay.classList.add("opacity-0", "pointer-events-none");
            searchingOverlay.classList.remove("opacity-100");

            if (data.found) {
              // Found visual indicator
              successMsg.textContent = `Aset "${data.name}" ditemukan. Mengalihkan...`;
              successOverlay.classList.remove("opacity-0", "pointer-events-none");
              successOverlay.classList.add("opacity-100");
              
              // Stop camera and redirect
              stopScanning().then(() => {
                setTimeout(() => {
                  window.location.href = `/inventory/${data.id}`;
                }, 1500);
              });
            } else {
              // Not found visual indicator
              failureMsg.textContent = `Label QR "${decodedText}" tidak terdaftar di sistem.`;
              failureOverlay.classList.remove("opacity-0", "pointer-events-none");
              failureOverlay.classList.add("opacity-100");

              // Hold for 2 seconds, then resume
              setTimeout(() => {
                failureOverlay.classList.add("opacity-0", "pointer-events-none");
                failureOverlay.classList.remove("opacity-100");
                isProcessing = false;
              }, 2000);
            }
          })
          .catch(err => {
            console.error("Error searching label:", err);
            searchingOverlay.classList.add("opacity-0", "pointer-events-none");
            searchingOverlay.classList.remove("opacity-100");
            
            failureMsg.textContent = "Terjadi kegagalan komunikasi data dengan server.";
            failureOverlay.classList.remove("opacity-0", "pointer-events-none");
            failureOverlay.classList.add("opacity-100");
            
            setTimeout(() => {
              failureOverlay.classList.add("opacity-0", "pointer-events-none");
              failureOverlay.classList.remove("opacity-100");
              isProcessing = false;
            }, 2000);
          });
      }

      function onScanError(err) {
        // Ignored to avoid spamming console and keep scanning
      }

      // Button listener
      toggleBtn.addEventListener("click", function () {
        if (isScanning) {
          stopScanning();
        } else {
          startScanning();
        }
      });

      // Change camera listener
      cameraSelect.addEventListener("change", function () {
        if (isScanning) {
          stopScanning().then(() => {
            startScanning();
          });
        }
      });
    });
