extends ../layouts/main.pug
include ../components/forms/input.pug

block content
  div(class="min-h-[80vh] flex items-center justify-center")
    div(class="w-full max-w-md bg-white rounded-xl shadow-sm border border-slate-200 p-8")
      div(class="text-center mb-8")
        h1(class="text-2xl font-bold text-slate-900") Selamat Datang Kembali
        p(class="text-sm text-slate-500 mt-2") Masukkan kredensial Anda untuk mengakses sistem
      
      if error
        div(class="mb-6 p-4 rounded-lg bg-red-50 border border-red-200 text-center")
          p(class="text-sm font-medium text-red-600")= error
      
      form(action="/login" method="POST" class="space-y-5")
        +inputField("email", "email", "Email / Nama Pengguna", '', "text", "john.doe@maranatha.ac.id", true)
        
        +inputField("password", "password", "Kata Sandi", '', "password", "••••••••", true)
        div(class="text-right -mt-2")
          a(href="#" class="text-xs font-medium text-green-600 hover:text-green-700") Lupa kata sandi?
        
        div(class="pt-2")
          button(type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-medium py-2.5 rounded-lg transition-colors shadow-sm") Masuk
