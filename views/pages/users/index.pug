extends ../../layouts/crud_index.pug
include ../../components/forms/select.pug

block sidebar
  if sessionUser && sessionUser.userRole === 'ADMIN'
    include ../../components/sidebars/admin.pug
  else if sessionUser && sessionUser.userRole === 'KAPRODI'
    include ../../components/sidebars/kaprodi.pug
  else if sessionUser && sessionUser.userRole === 'KALAB'
    include ../../components/sidebars/kepala_lab.pug
  else if sessionUser && sessionUser.userRole === 'STAF_ADMIN'
    include ../../components/sidebars/staf_admin.pug
  else if sessionUser && sessionUser.userRole === 'STAF_LAB'
    include ../../components/sidebars/staf_lab.pug

block crud_title
  | Data Pengguna

block crud_subtitle
  | Kelola data pengguna, peran, dan akses sistem.

block crud_create_button
  div(class="flex flex-wrap items-center gap-3")
    // Role Filter
    - 
      const roleFilterOptions = [
        { value: '', label: 'Semua Peran' },
        ...(roles || []).map(r => ({ value: r.id, label: r.description || r.name }))
      ]
    +selectField("roleId", "roleId", null, roleFilterOptions, selectedRoleId || '', false, "py-2 pl-3 pr-10 min-w-[155px]")(onchange="applyFilters(this)")

    // Status Filter
    - 
      const statusFilterOptions = [
        { value: '', label: 'Semua Status' },
        { value: 'ACTIVE', label: 'Aktif' },
        { value: 'INACTIVE', label: 'Tidak Aktif' }
      ]
    +selectField("status", "status", null, statusFilterOptions, selectedStatus || '', false, "py-2 pl-3 pr-10 min-w-[145px]")(onchange="applyFilters(this)")

    // Add User Button
    a(href="/users/new" class="inline-flex items-center justify-center bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-colors whitespace-nowrap")
      svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4")
      | Tambah User

  script.
    function applyFilters(el) {
      const url = new URL(window.location.href);
      if (el.value) {
        url.searchParams.set(el.name, el.value);
      } else {
        url.searchParams.delete(el.name);
      }
      url.searchParams.delete('page'); // Reset to page 1 on filter change
      window.location.href = url.pathname + url.search;
    }

block crud_table_headers
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Nama
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Email
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Role
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Status
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Tanggal Dibuat
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right") Aksi

block crud_table_rows
  if users && users.length > 0
    each user in users
      tr(class="hover:bg-slate-50/50 transition-colors group")
        td(class="px-6 py-4 whitespace-nowrap")
          div(class="flex items-center")
            div(class="h-9 w-9 rounded-full bg-green-100 flex items-center justify-center text-green-700 font-bold text-sm mr-3")
              = user.name.charAt(0).toUpperCase()
            div(class="text-sm font-medium text-slate-900")= user.name
        td(class="px-6 py-4 whitespace-nowrap text-sm text-slate-600")= user.email
        td(class="px-6 py-4 whitespace-nowrap")
          span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800")
            = user.role ? user.role.description : 'Unknown'
        td(class="px-6 py-4 whitespace-nowrap")
          if user.isActive !== false
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800") Aktif
          else
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800") Tidak Aktif
        td(class="px-6 py-4 whitespace-nowrap text-sm text-slate-500")
          = new Date(user.createdAt).toLocaleDateString('id-ID', {day: '2-digit', month: 'long', year: 'numeric'})
        td(class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium")
          div(class="flex items-center justify-end space-x-2")
            a(href=`/users/${user.id}/edit` class="text-blue-600 hover:text-blue-900 p-1 rounded hover:bg-blue-50" title="Ubah")
              svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z")
            form(action=`/users/${user.id}?_method=DELETE` method="POST" class="inline-block" onsubmit="return confirm('Apakah Anda yakin ingin menghapus pengguna ini?');")
              button(type="submit" class="text-red-600 hover:text-red-900 p-1 rounded hover:bg-red-50" title="Hapus")
                svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16")
