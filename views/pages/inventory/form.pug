extends ../../layouts/crud_form.pug
include ../../components/forms/input.pug
include ../../components/forms/select.pug

block sidebar
  - formEnctype = "multipart/form-data"
  if sessionUser && sessionUser.userRole === 'ADMIN'
    include ../../components/sidebars/admin.pug
  else if sessionUser && sessionUser.userRole === 'KAPRODI'
    include ../../components/sidebars/kaprodi.pug
  else if sessionUser && sessionUser.userRole === 'KALAB'
    include ../../components/sidebars/kepala_lab.pug
  else if sessionUser && sessionUser.userRole === 'STAF_ADMIN'
    include ../../components/sidebars/staf_admin.pug
  else if sessionUser && sessionUser.userRole === 'STAF_LAB'
    include ../../components/sidebars/staf_lab.pug

block crud_form_title
  = isPut ? 'Ubah Barang Inventaris' : 'Tambah Aset Baru'

block crud_form_subtitle
  | Masukkan detail spesifikasi dan lokasi penyimpanan barang di bawah ini.

block crud_form_fields
  if currentQuery && currentQuery.error
    div(class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 text-sm font-medium rounded-xl flex items-center gap-3 animate-pulse")
      svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z")
      span= currentQuery.error

  - 
    const roomOptions = (rooms || []).map(r => ({ value: r.id, label: r.name }));
    const conditionOptions = [
      { value: 'GOOD', label: 'Baik (GOOD)' },
      { value: 'MAINTENANCE', label: 'Dalam Perawatan (MAINTENANCE)' },
      { value: 'BROKEN', label: 'Rusak (BROKEN)' },
      { value: 'DISPOSED', label: 'Dibuang/Dihapus (DISPOSED)' }
    ];

  div(class="grid grid-cols-1 md:grid-cols-2 gap-6")
    +inputField("name", "name", "Nama Barang / Aset", item ? item.name : '', "text", "Contoh: Lenovo ThinkCentre M70q Gen 4", true)
    
    if isPut
      +inputField("labelNumber", "labelNumber", "Nomor Label / Kode Aset", item ? item.labelNumber : '', "text", "")(disabled=true class="bg-slate-100 cursor-not-allowed text-slate-500")
    
    +selectField("roomId", "roomId", "Lokasi Ruangan", roomOptions, item ? item.roomId : '', true)
    
    +selectField("condition", "condition", "Kondisi Aset", conditionOptions, item ? item.condition : 'GOOD', true)
    
    div(class="md:col-span-2 space-y-2")
      label(for="qrCodePhoto" class="text-sm font-medium text-slate-700 block") Unggah QR Code Manual (Gambar)
      input(
        id="qrCodePhoto"
        type="file"
        name="qrCodePhoto"
        accept="image/*"
        class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 transition-colors text-sm"
      )
      p(class="text-xs text-slate-500") Format gambar yang didukung: JPEG, JPG, PNG, GIF, SVG. Ukuran maksimal 5MB.
      if item && item.qrCodePhotoPath
        div(class="mt-3 p-3 bg-slate-50 border border-slate-200 rounded-lg flex items-center gap-4 w-fit")
          img(src=item.qrCodePhotoPath class="w-16 h-16 object-contain rounded border border-slate-200 bg-white" alt="QR Code Manual")
          div
            p(class="text-xs font-semibold text-slate-700") QR Code Manual Saat Ini
            p(class="text-xs text-slate-500 mt-0.5") Anda dapat mengunggah file baru untuk menggantinya.
    
    div(class="md:col-span-2")
      div(class="p-4 bg-blue-50 border border-blue-100 rounded-xl flex items-start gap-3")
        svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z")
        div
          h4(class="text-sm font-semibold text-blue-800") Info QR Code
          p(class="text-xs text-blue-600 mt-1") QR Code untuk barang ini akan dibuat secara otomatis oleh sistem setelah data disimpan. Anda dapat melihat dan mengunduh QR Code tersebut di halaman Detail Aset.

block crud_form_submit_label
  = isPut ? 'Simpan Perubahan' : 'Daftarkan Aset Baru'
