extends ../../layouts/main.pug

block sidebar
  if sessionUser && sessionUser.userRole === 'ADMIN'
    include ../../components/sidebars/admin.pug
  else if sessionUser && sessionUser.userRole === 'KAPRODI'
    include ../../components/sidebars/kaprodi.pug
  else if sessionUser && sessionUser.userRole === 'KALAB'
    include ../../components/sidebars/kepala_lab.pug
  else if sessionUser && sessionUser.userRole === 'STAF_ADMIN'
    include ../../components/sidebars/staf_admin.pug
  else if sessionUser && sessionUser.userRole === 'STAF_LAB'
    include ../../components/sidebars/staf_lab.pug

block content
  div(class="max-w-4xl mx-auto space-y-6 pb-12")
    //- Breadcrumb & Back Button
    div(class="flex items-center gap-3 mb-6")
      a(href="/inventory" class="text-slate-400 hover:text-slate-600 transition-colors p-2 hover:bg-slate-100 rounded-xl")
        svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18")
      div
        h1(class="text-2xl font-extrabold text-slate-900") Detail Aset Inventaris
        p(class="text-sm text-slate-500 mt-1") Tinjau informasi detail aset dan riwayat maintenance.

    //- Info Card
    div(class="bg-white border border-slate-200 p-6 sm:p-8 rounded-2xl shadow-sm space-y-6 relative overflow-hidden")
      div(class="absolute top-0 right-0 w-48 h-48 bg-green-500/5 rounded-full blur-3xl")
      
      div(class="flex flex-col sm:flex-row gap-12 sm:gap-20")
        //- QR Code Display
        div(class="flex flex-col items-center gap-3 shrink-0")
          div(class="p-2 border-2 border-slate-100 rounded-2xl bg-white shadow-sm")
            img(src=`/inventory/${item.id}/qr` alt="QR Code" class="w-40 h-40 object-cover rounded-xl")
          a(href=`/inventory/${item.id}/qr` download=`QR_${item.labelNumber || item.id}.png` class="text-xs font-bold text-green-600 hover:text-green-700 bg-green-50 hover:bg-green-100 px-4 py-2 rounded-lg transition-colors flex items-center gap-1.5")
            svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4")
            | Unduh QR
            
        //- Details
        div(class="flex-1 space-y-5")
          div
            h2(class="text-2xl font-bold text-slate-900 mb-1")= item.name
            div(class="flex items-center gap-2")
              if item.labelNumber
                span(class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-green-50 text-green-700 border border-green-200/50 font-mono")= item.labelNumber
              else
                span(class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-slate-100 text-slate-500 border border-slate-200/50 italic") Belum Berlabel

          div(class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-4 border-t border-slate-100")
            div
              p(class="text-slate-400 font-medium text-xs uppercase tracking-wider mb-1") Kondisi Aset
              if item.condition === 'GOOD'
                span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200") BAIK
              else if item.condition === 'MAINTENANCE'
                span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200") PERAWATAN
              else if item.condition === 'BROKEN'
                span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800 border border-red-200") RUSAK
              else if item.condition === 'DISPOSED'
                span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200") DIBUANG

            div
              p(class="text-slate-400 font-medium text-xs uppercase tracking-wider mb-1") Lokasi Ruangan
              p(class="text-slate-800 font-semibold")= item.room ? item.room.name : '-'

            div
              p(class="text-slate-400 font-medium text-xs uppercase tracking-wider mb-1") Tanggal Registrasi
              p(class="text-slate-800 font-semibold")= new Date(item.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
            
            div
              p(class="text-slate-400 font-medium text-xs uppercase tracking-wider mb-1") ID Sistem
              p(class="text-slate-800 font-semibold") ##{item.id}

      if sessionUser && (sessionUser.userRole === 'ADMIN' || sessionUser.userRole === 'STAF_LAB' || sessionUser.userRole === 'STAF_ADMIN')
        div(class="pt-6 border-t border-slate-100 flex justify-end")
          a(href=`/inventory/${item.id}/edit` class="inline-flex items-center px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold rounded-xl shadow-sm transition-colors gap-2")
            svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z")
            | Edit Data Aset
