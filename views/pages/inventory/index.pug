extends ../../layouts/crud_index.pug

block sidebar
  if sessionUser && sessionUser.userRole === 'ADMIN'
    include ../../components/sidebars/admin.pug
  else if sessionUser && sessionUser.userRole === 'KAPRODI'
    include ../../components/sidebars/kaprodi.pug
  else if sessionUser && sessionUser.userRole === 'KALAB'
    include ../../components/sidebars/kepala_lab.pug
  else if sessionUser && sessionUser.userRole === 'STAF_ADMIN'
    include ../../components/sidebars/staf_admin.pug
  else if sessionUser && sessionUser.userRole === 'STAF_LAB'
    include ../../components/sidebars/staf_lab.pug

block crud_title
  | Data Inventaris (Aset)

block crud_subtitle
  | Kelola data barang inventaris dan aset tetap laboratorium.

block crud_create_button
  div(class="flex flex-wrap items-center gap-3")
    // Room Filter
    div(class="relative flex items-center")
      select(name="roomId" class="pl-3 pr-8 py-2 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 text-sm bg-white cursor-pointer appearance-none min-w-[150px]" onchange="applyFilters(this)")
        option(value="") Semua Ruangan
        each r in rooms
          option(value=r.id selected=(String(selectedRoomId) === String(r.id)))= r.name
      div(class="absolute right-2.5 pointer-events-none text-slate-400")
        svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7")

    // Condition Filter
    div(class="relative flex items-center")
      select(name="condition" class="pl-3 pr-8 py-2 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 text-sm bg-white cursor-pointer appearance-none min-w-[140px]" onchange="applyFilters(this)")
        option(value="") Semua Kondisi
        option(value="GOOD" selected=(selectedCondition === 'GOOD')) Baik
        option(value="MAINTENANCE" selected=(selectedCondition === 'MAINTENANCE')) Perawatan
        option(value="BROKEN" selected=(selectedCondition === 'BROKEN')) Rusak
        option(value="DISPOSED" selected=(selectedCondition === 'DISPOSED')) Dibuang
      div(class="absolute right-2.5 pointer-events-none text-slate-400")
        svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7")

    // Add Button
    if sessionUser && (sessionUser.userRole === 'ADMIN' || sessionUser.userRole === 'STAF_LAB' || sessionUser.userRole === 'STAF_ADMIN')
      a(href="/inventory/new" class="inline-flex items-center justify-center bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-colors whitespace-nowrap")
        svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4")
        | Tambah Aset

  script.
    function applyFilters(el) {
      const url = new URL(window.location.href);
      if (el.value) {
        url.searchParams.set(el.name, el.value);
      } else {
        url.searchParams.delete(el.name);
      }
      url.searchParams.delete('page'); // Reset to page 1 on filter change
      window.location.href = url.pathname + url.search;
    }

block crud_table_headers
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Label Aset
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Nama Barang
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Lokasi Ruangan
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Kondisi
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Tanggal Input
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right") Aksi

block crud_table_rows
  if inventories && inventories.length > 0
    each item in inventories
      tr(class="hover:bg-slate-50/50 transition-colors group")
        td(class="px-6 py-4 whitespace-nowrap")
          if item.labelNumber
            span(class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-green-50 text-green-700 border border-green-200/50 font-mono")= item.labelNumber
          else
            span(class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-slate-100 text-slate-500 border border-slate-200/50 italic") Belum Berlabel
        td(class="px-6 py-4 whitespace-nowrap")
          div(class="flex items-center")
            div(class="h-9 w-9 rounded-lg bg-green-50 border border-green-100 flex items-center justify-center text-green-600 mr-3")
              svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z")
            div
              div(class="text-sm font-medium text-slate-900")= item.name
              if item.qrCodePhotoPath
                div(class="text-xs text-slate-400 flex items-center mt-0.5")
                  svg(xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z")
                  | Memiliki QR Code
          
        td(class="px-6 py-4 whitespace-nowrap text-sm text-slate-600")
          = item.room ? item.room.name : 'Unknown Room'
        td(class="px-6 py-4 whitespace-nowrap")
          if item.condition === 'GOOD'
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200") BAIK
          else if item.condition === 'MAINTENANCE'
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200") PERAWATAN
          else if item.condition === 'BROKEN'
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800 border border-red-200") RUSAK
          else if item.condition === 'DISPOSED'
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200") DIBUANG
        td(class="px-6 py-4 whitespace-nowrap text-sm text-slate-500")
          = new Date(item.createdAt).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })
        td(class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium")
          if sessionUser && (sessionUser.userRole === 'ADMIN' || sessionUser.userRole === 'STAF_LAB' || sessionUser.userRole === 'STAF_ADMIN')
            div(class="flex items-center justify-end space-x-2")
              a(href=`/inventory/${item.id}/edit` class="text-blue-600 hover:text-blue-900 p-1.5 rounded-lg hover:bg-blue-50 transition-colors" title="Ubah")
                svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z")
              form(action=`/inventory/${item.id}?_method=DELETE` method="POST" class="inline-block" onsubmit="return confirm('Apakah Anda yakin ingin menghapus barang inventaris ini?');")
                button(type="submit" class="text-red-600 hover:text-red-900 p-1.5 rounded-lg hover:bg-red-50 transition-colors" title="Hapus")
                  svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16")
          else
            span(class="text-xs text-slate-400") Tidak Ada Aksi
  else
    tr
      td(colspan="6" class="px-6 py-8 text-center text-slate-500 bg-white")
        div(class="flex flex-col items-center justify-center space-y-2")
          svg(xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4")
          p Tidak ada barang inventaris yang ditemukan.
