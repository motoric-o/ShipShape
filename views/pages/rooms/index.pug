extends ../../layouts/crud_index.pug

block sidebar
  if sessionUser && sessionUser.userRole === 'ADMIN'
    include ../../components/sidebars/admin.pug
  else if sessionUser && sessionUser.userRole === 'KAPRODI'
    include ../../components/sidebars/kaprodi.pug
  else if sessionUser && sessionUser.userRole === 'KALAB'
    include ../../components/sidebars/kepala_lab.pug
  else if sessionUser && sessionUser.userRole === 'STAF_ADMIN'
    include ../../components/sidebars/staf_admin.pug
  else if sessionUser && sessionUser.userRole === 'STAF_LAB'
    include ../../components/sidebars/staf_lab.pug

block crud_title
  | Data Ruangan

block crud_subtitle
  | Kelola data ruangan laboratorium yang ada di sistem.

block crud_create_button
  a(href="/rooms/new" class="inline-flex items-center justify-center bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-colors whitespace-nowrap")
    svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor")
      path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4")
    | Tambah Ruangan

block crud_table_headers
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Nama Ruangan
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Deskripsi
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Total Inventaris
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right") Aksi

block crud_table_rows
  each room in rooms
    tr(class="hover:bg-slate-50/50 transition-colors group")
      td(class="px-6 py-4 whitespace-nowrap")
        div(class="flex items-center")
          div(class="h-9 w-9 rounded-lg bg-green-50 border border-green-100 flex items-center justify-center text-green-600 mr-3")
            svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4")
          div(class="text-sm font-medium text-slate-900")= room.name
      td(class="px-6 py-4 text-sm text-slate-600 max-w-xs truncate")= room.description
      td(class="px-6 py-4 whitespace-nowrap text-sm text-slate-500")
        span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800")
          = (room._count ? room._count.inventories : 0) + ' Items'
      td(class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium")
        div(class="flex items-center justify-end space-x-2")
          a(href=`/rooms/${room.id}/edit` class="text-blue-600 hover:text-blue-900 p-1 rounded hover:bg-blue-50" title="Ubah")
            svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z")
          form(action=`/rooms/${room.id}?_method=DELETE` method="POST" class="inline-block" onsubmit="return confirm('Apakah Anda yakin ingin menghapus ruangan ini?');")
            button(type="submit" class="text-red-600 hover:text-red-900 p-1 rounded hover:bg-red-50" title="Hapus")
              svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16")
