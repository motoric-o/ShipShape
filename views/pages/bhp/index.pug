extends ../../layouts/crud_index.pug
include ../../components/forms/select.pug

block sidebar
  if sessionUser && sessionUser.userRole === 'ADMIN'
    include ../../components/sidebars/admin.pug
  else if sessionUser && sessionUser.userRole === 'KAPRODI'
    include ../../components/sidebars/kaprodi.pug
  else if sessionUser && sessionUser.userRole === 'KALAB'
    include ../../components/sidebars/kepala_lab.pug
  else if sessionUser && sessionUser.userRole === 'STAF_ADMIN'
    include ../../components/sidebars/staf_admin.pug
  else if sessionUser && sessionUser.userRole === 'STAF_LAB'
    include ../../components/sidebars/staf_lab.pug

block crud_title
  | Bahan Habis Pakai (BHP)

block crud_subtitle
  | Kelola persediaan stok barang habis pakai laboratorium.

block crud_create_button
  div(class="flex flex-wrap items-center gap-3")
    // Room Filter
    - 
      const roomFilterOptions = [
        { value: '', label: 'Semua Ruangan' },
        ...(rooms || []).map(r => ({ value: r.id, label: r.name }))
      ]
    +selectField("roomId", "roomId", null, roomFilterOptions, selectedRoomId || '', false, "py-2 pl-3 pr-10 min-w-[155px]")(onchange="applyFilters(this)")

    // Stock Status Filter
    - 
      const statusFilterOptions = [
        { value: '', label: 'Semua Status Stok' },
        { value: 'EMPTY', label: 'Habis / Kosong' },
        { value: 'LOW', label: 'Stok Minim (<= 5)' },
        { value: 'OK', label: 'Stok Cukup (> 5)' }
      ]
    +selectField("status", "status", null, statusFilterOptions, selectedStatus || '', false, "py-2 pl-3 pr-10 min-w-[170px]")(onchange="applyFilters(this)")

    // Add Button
    if sessionUser && (sessionUser.userRole === 'ADMIN' || sessionUser.userRole === 'STAF_LAB')
      a(href="/bhp/new" class="inline-flex items-center justify-center bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-colors whitespace-nowrap")
        svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4")
        | Tambah BHP

  script.
    function applyFilters(el) {
      const url = new URL(window.location.href);
      if (el.value) {
        url.searchParams.set(el.name, el.value);
      } else {
        url.searchParams.delete(el.name);
      }
      url.searchParams.delete('page'); // Reset to page 1 on filter change
      window.location.href = url.pathname + url.search;
    }

    function toggleStockButton(inputEl) {
      const form = inputEl.closest('form');
      const btn = form.querySelector('.stock-save-btn');
      const originalValue = inputEl.getAttribute('data-original');
      if (inputEl.value !== originalValue) {
        btn.classList.remove('opacity-0', 'pointer-events-none');
        btn.classList.add('opacity-100', 'pointer-events-auto');
      } else {
        btn.classList.add('opacity-0', 'pointer-events-none');
        btn.classList.remove('opacity-100', 'pointer-events-auto');
      }
    }

block crud_table_headers
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Nama Barang
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Lokasi Ruangan
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Persediaan Stok
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Hitung Fisik
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Status Stok
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right") Aksi

block crud_table_rows
  if currentQuery && currentQuery.error
    tr
      td(colspan="6" class="px-6 py-3")
        div(class="p-3.5 bg-red-50 border border-red-200 text-red-700 text-sm font-medium rounded-lg flex items-center gap-2.5")
          svg(xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z")
          span= currentQuery.error

  if bhps && bhps.length > 0
    each item in bhps
      tr(class="hover:bg-slate-50/50 transition-colors group")
        td(class="px-6 py-4 whitespace-nowrap")
          div(class="flex items-center")
            div(class="h-9 w-9 rounded-lg bg-orange-50 border border-orange-100 flex items-center justify-center text-orange-600 mr-3")
              svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4")
            div(class="text-sm font-medium text-slate-900")= item.name
        td(class="px-6 py-4 whitespace-nowrap text-sm text-slate-600")
          = item.room ? item.room.name : 'Unknown Room'
        td(class="px-6 py-4 whitespace-nowrap")
          span(class="font-mono text-sm font-bold text-slate-700 px-3 py-1 rounded bg-slate-100 border border-slate-200/50")= `${item.stock} ${item.unit || 'pcs'}`
        td(class="px-6 py-4 whitespace-nowrap")
          if sessionUser && (sessionUser.userRole === 'ADMIN' || sessionUser.userRole === 'STAF_LAB')
            form(action=`/bhp/${item.id}/stock?_method=PATCH` method="POST" class="inline-flex items-center gap-2 min-w-[135px]" onsubmit="return confirm('Apakah Anda yakin ingin mengupdate stok fisik barang ini? Sistem akan disesuaikan menjadi angka yang dimasukkan.');")
              input(type="number" name="stock" min="0" value=`${item.stock}` data-original=`${item.stock}` oninput="toggleStockButton(this)" class="w-12 h-9 px-2 rounded-lg border border-slate-200 hover:border-slate-300 focus:outline-none focus:ring-2 focus:ring-green-500/20 focus:border-green-500 text-center font-mono font-bold text-slate-800 text-xs transition-colors shadow-sm")
              button(type="submit" class="stock-save-btn h-8 px-2.5 rounded-lg bg-green-600 hover:bg-green-700 active:bg-green-800 text-white font-semibold text-[9px] uppercase tracking-wider transition-all duration-200 flex items-center gap-0.5 active:scale-95 opacity-0 pointer-events-none shadow-sm shadow-green-600/10 hover:shadow" title="Simpan Perubahan Stok")
                svg(xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7")
                span Simpan
          else
            span(class="text-xs text-slate-400 italic") Tidak Ada Akses
        td(class="px-6 py-4 whitespace-nowrap")
          if item.stock <= 0
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800 border border-red-200 animate-pulse") Habis
          else if item.stock <= 5
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-orange-100 text-orange-800 border border-orange-200") Stok Minim
          else
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200") Cukup
        td(class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium")
          if sessionUser && (sessionUser.userRole === 'ADMIN' || sessionUser.userRole === 'STAF_LAB')
            div(class="flex items-center justify-end space-x-2")
              a(href=`/bhp/${item.id}/edit` class="text-blue-600 hover:text-blue-900 p-1.5 rounded-lg hover:bg-blue-50 transition-colors" title="Ubah")
                svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z")
              form(action=`/bhp/${item.id}?_method=DELETE` method="POST" class="inline-block" onsubmit="return confirm('Apakah Anda yakin ingin menghapus BHP ini?');")
                button(type="submit" class="text-red-600 hover:text-red-900 p-1.5 rounded-lg hover:bg-red-50 transition-colors" title="Hapus")
                  svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16")
          else
            span(class="text-xs text-slate-400") Tidak Ada Aksi
  else
    tr
      td(colspan="6" class="px-6 py-8 text-center text-slate-500 bg-white")
        div(class="flex flex-col items-center justify-center space-y-2")
          svg(xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4")
          p Tidak ada bahan habis pakai (BHP) yang ditemukan.
