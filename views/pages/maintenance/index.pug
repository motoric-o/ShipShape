extends ../../layouts/crud_index.pug
include ../../components/forms/select.pug

block sidebar
  if sessionUser && sessionUser.userRole === 'ADMIN'
    include ../../components/sidebars/admin.pug
  else if sessionUser && sessionUser.userRole === 'KAPRODI'
    include ../../components/sidebars/kaprodi.pug
  else if sessionUser && sessionUser.userRole === 'KALAB'
    include ../../components/sidebars/kepala_lab.pug
  else if sessionUser && sessionUser.userRole === 'STAF_ADMIN'
    include ../../components/sidebars/staf_admin.pug
  else if sessionUser && sessionUser.userRole === 'STAF_LAB'
    include ../../components/sidebars/staf_lab.pug

block crud_title
  | Pemeliharaan Aset (Maintenance Logs)

block crud_subtitle
  | Catatan riwayat perawatan, perbaikan, dan kesehatan inventaris laboratorium.

block crud_create_button
  div(class="flex flex-wrap items-center gap-3")
    // Asset Filter
    - 
      const inventoryFilterOptions = [
        { value: '', label: 'Semua Aset' },
        ...(inventories || []).map(inv => ({ value: inv.id, label: inv.name + (inv.labelNumber ? ` (${inv.labelNumber})` : '') }))
      ]
    +selectField("inventoryId", "inventoryId", null, inventoryFilterOptions, selectedInventoryId || '', false, "py-2 pl-3 pr-10 max-w-[200px] text-ellipsis overflow-hidden whitespace-nowrap")(onchange="applyFilters(this)")

    // Condition Filter
    - 
      const conditionFilterOptions = [
        { value: '', label: 'Semua Kondisi Akhir' },
        { value: 'GOOD', label: 'BAIK' },
        { value: 'MAINTENANCE', label: 'PERAWATAN' },
        { value: 'BROKEN', label: 'RUSAK' },
        { value: 'DISPOSED', label: 'DIBUANG' }
      ]
    +selectField("condition", "condition", null, conditionFilterOptions, selectedCondition || '', false, "py-2 pl-3 pr-10 min-w-[155px]")(onchange="applyFilters(this)")

    // Add Button
    if sessionUser && (sessionUser.userRole === 'ADMIN' || sessionUser.userRole === 'STAF_LAB')
      a(href="/maintenance/new" class="inline-flex items-center justify-center bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-colors whitespace-nowrap")
        svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4")
        | Catat Pemeliharaan

  script.
    function applyFilters(el) {
      const url = new URL(window.location.href);
      if (el.value) {
        url.searchParams.set(el.name, el.value);
      } else {
        url.searchParams.delete(el.name);
      }
      url.searchParams.delete('page'); // Reset to page 1 on filter change
      window.location.href = url.pathname + url.search;
    }

block crud_table_headers
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Tanggal
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Inventaris / Aset
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Deskripsi Tindakan
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Kondisi Akhir
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Dilakukan Oleh
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right") Aksi

block crud_table_rows
  if logs && logs.length > 0
    each log in logs
      tr(class="hover:bg-slate-50/50 transition-colors group")
        td(class="px-6 py-4 whitespace-nowrap text-sm text-slate-500")
          = new Date(log.maintenanceDate || log.createdAt).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })
        td(class="px-6 py-4 whitespace-nowrap")
          if log.inventory
            div(class="text-sm font-medium text-slate-900")= log.inventory.name
            if log.inventory.labelNumber
              div(class="text-xs font-mono text-slate-400 mt-0.5")= log.inventory.labelNumber
          else
            span(class="text-sm text-slate-400 italic") Aset Dihapus
        td(class="px-6 py-4 text-sm text-slate-600 max-w-xs truncate")= log.description
        td(class="px-6 py-4 whitespace-nowrap")
          if log.conditionAfter === 'GOOD'
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200") BAIK
          else if log.conditionAfter === 'MAINTENANCE'
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200") PERAWATAN
          else if log.conditionAfter === 'BROKEN'
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800 border border-red-200") RUSAK
          else if log.conditionAfter === 'DISPOSED'
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200") DIBUANG
        td(class="px-6 py-4 whitespace-nowrap text-sm text-slate-600")
          div(class="font-medium")= log.performedBy ? log.performedBy.name : 'Unknown User'
          div(class="text-xs text-slate-400 mt-0.5")= log.performedBy ? log.performedBy.email : ''
        td(class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium")
          div(class="flex items-center justify-end space-x-2")
            a(href=`/maintenance/${log.id}` class="text-green-600 hover:text-green-900 p-1.5 rounded-lg hover:bg-green-50 transition-colors flex items-center gap-1" title="Detail Pemeliharaan")
              svg(xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z")
              span Detail
            
            if sessionUser && (sessionUser.userRole === 'ADMIN' || sessionUser.userRole === 'STAF_LAB')
              form(action=`/maintenance/${log.id}?_method=DELETE` method="POST" class="inline-block" onsubmit="return confirm('Apakah Anda yakin ingin menghapus log pemeliharaan ini? Pilihan ini tidak dapat dibatalkan.');")
                button(type="submit" class="text-red-600 hover:text-red-900 p-1.5 rounded-lg hover:bg-red-50 transition-colors" title="Hapus")
                  svg(xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16")
  else
    tr
      td(colspan="6" class="px-6 py-8 text-center text-slate-500 bg-white")
        div(class="flex flex-col items-center justify-center space-y-2")
          svg(xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01")
          p Tidak ada log pemeliharaan aset yang ditemukan.
