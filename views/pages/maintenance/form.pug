extends ../../layouts/crud_form.pug
include ../../components/forms/input.pug
include ../../components/forms/select.pug
include ../../components/forms/textarea.pug
include ../../components/forms/searchable_select.pug

block sidebar
  if sessionUser && sessionUser.userRole === 'ADMIN'
    include ../../components/sidebars/admin.pug
  else if sessionUser && sessionUser.userRole === 'KAPRODI'
    include ../../components/sidebars/kaprodi.pug
  else if sessionUser && sessionUser.userRole === 'KALAB'
    include ../../components/sidebars/kepala_lab.pug
  else if sessionUser && sessionUser.userRole === 'STAF_ADMIN'
    include ../../components/sidebars/staf_admin.pug
  else if sessionUser && sessionUser.userRole === 'STAF_LAB'
    include ../../components/sidebars/staf_lab.pug

block crud_form_title
  | Catat Log Pemeliharaan Aset

block crud_form_subtitle
  | Laporkan riwayat pemeliharaan, kalibrasi, perbaikan, dan penggunaan suku cadang/BHP.

block crud_form_fields
  if currentQuery && currentQuery.error
    div(class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 text-sm font-medium rounded-xl flex items-center gap-3 animate-pulse")
      svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z")
      span= currentQuery.error

  - 
    const roomOptions = (rooms || []).map(r => ({
      value: r.id,
      label: r.name
    }));
    const today = new Date().toISOString().split('T')[0];

  div(class="grid grid-cols-1 md:grid-cols-2 gap-6")
    div(class="md:col-span-2")
      +selectField("roomId", "roomId", "Pilih Ruangan", roomOptions, selectedRoomId || '', true)
    
    // Assets List Container
    div(class="md:col-span-2 space-y-3 hidden" id="assets-container")
      div
        label(class="text-sm font-semibold text-slate-800 block") Daftar Aset dalam Ruangan
        p(class="text-xs text-slate-500") Pilih aset yang dilakukan pemeliharaan dan perbarui kondisinya.
      
      div(class="border border-slate-200 rounded-xl overflow-hidden bg-white shadow-sm")
        // Header
        div(class="grid grid-cols-12 gap-4 bg-slate-50 p-4 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider")
          div(class="col-span-6 flex items-center") Aset / Barang
          div(class="col-span-3 text-center") Kondisi Saat Ini
          div(class="col-span-3 text-center") Kondisi Setelah Pemeliharaan
        
        // Asset Rows
        div(class="divide-y divide-slate-100 max-h-96 overflow-y-auto" id="assets-list")
          if inventories && inventories.length > 0
            each asset, index in inventories
              div(class="asset-row grid grid-cols-12 gap-4 p-4 items-center hover:bg-slate-50/50 transition-colors hidden" data-room-id=asset.roomId data-asset-id=asset.id)
                // Col 1: Checkbox & Name
                div(class="col-span-6 flex items-center gap-3")
                  input(
                    type="checkbox"
                    id=`assets-checked-${index}`
                    name=`assets[${index}][checked]`
                    class="h-4.5 w-4.5 rounded border-slate-300 text-green-600 focus:ring-green-500/50 transition-colors cursor-pointer"
                    data-asset-index=index
                  )
                  input(
                    type="hidden"
                    name=`assets[${index}][id]`
                    value=asset.id
                  )
                  label(for=`assets-checked-${index}` class="text-sm font-medium text-slate-800 cursor-pointer select-none")
                    span(class="font-semibold block text-slate-900")= asset.name
                    if asset.labelNumber
                      span(class="text-xs text-slate-500 block mt-0.5 font-mono bg-slate-100 px-1.5 py-0.5 rounded w-max")= asset.labelNumber
                    else
                      span(class="text-xs text-slate-400 block mt-0.5 italic") Belum Berlabel

                // Col 2: Current Condition (Disabled Select)
                div(class="col-span-3")
                  div(class="relative")
                    select(
                      disabled=true
                      class="block w-full rounded-lg border border-slate-200 bg-slate-50 pl-3 pr-8 py-1.5 text-xs text-slate-500 cursor-not-allowed font-medium appearance-none"
                    )
                      option(value="GOOD" selected=asset.condition === 'GOOD') Baik (GOOD)
                      option(value="MAINTENANCE" selected=asset.condition === 'MAINTENANCE') Perawatan (MAINTENANCE)
                      option(value="BROKEN" selected=asset.condition === 'BROKEN') Rusak (BROKEN)
                      option(value="DISPOSED" selected=asset.condition === 'DISPOSED') Dihapus (DISPOSED)
                    div(class="absolute inset-y-0 right-0 flex items-center pr-2.5 pointer-events-none text-slate-300")
                      svg(xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7")

                // Col 3: After Condition
                div(class="col-span-3")
                  div(class="relative")
                    select(
                      name=`assets[${index}][conditionAfter]`
                      id=`assets-after-${index}`
                      disabled=true
                      class="asset-after-select block w-full rounded-lg border border-slate-300 bg-white pl-3 pr-8 py-1.5 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 font-medium transition-all opacity-50 cursor-not-allowed appearance-none"
                    )
                      option(value="GOOD" selected=asset.condition === 'GOOD') Baik (GOOD)
                      option(value="MAINTENANCE" selected=asset.condition === 'MAINTENANCE') Perawatan (MAINTENANCE)
                      option(value="BROKEN" selected=asset.condition === 'BROKEN') Rusak (BROKEN)
                      option(value="DISPOSED" selected=asset.condition === 'DISPOSED') Dihapus (DISPOSED)
                    div(class="absolute inset-y-0 right-0 flex items-center pr-2.5 pointer-events-none text-slate-400")
                      svg(xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7")
        
        // Empty state inside the box
        div(id="assets-empty-state" class="text-center py-8 text-slate-500 text-sm italic hidden")
          | Tidak ada aset di ruangan ini.
    
    div(class="md:col-span-2")
      +inputField("maintenanceDate", "maintenanceDate", "Tanggal Tindakan Pemeliharaan", today, "date", "", true)
    
    div(class="md:col-span-2")
      +textareaField("description", "description", "Deskripsi Tindakan & Detail Perbaikan", '', "Jelaskan kerusakan awal, perbaikan yang dilakukan, dan detail solusi teknis...", 4, true)
    
    // BHP usages selection
    div(class="md:col-span-2 space-y-3")
      div(class="flex flex-col sm:flex-row sm:items-center justify-between gap-3")
        div
          label(class="text-sm font-semibold text-slate-800 block") Suku Cadang / BHP yang Digunakan (Opsional)
          p(class="text-xs text-slate-500") Tentukan jumlah suku cadang atau bahan habis pakai yang dikonsumsi selama pemeliharaan ini.
        if bhps && bhps.length > 0
          div(class="w-full sm:w-64 relative flex items-center")
            input(
              type="text"
              id="bhp-search"
              placeholder="Cari suku cadang / BHP..."
              class="w-full pl-9 pr-3 py-1.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 transition-colors bg-white text-sm"
            )
            div(class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none")
              svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
      
      div(class="max-h-60 overflow-y-auto border border-slate-200 rounded-xl divide-y divide-slate-100 bg-slate-50 p-2" id="bhp-list-container")
        if bhps && bhps.length > 0
          each bhp, index in bhps
            div(class="bhp-item flex items-center justify-between gap-4 p-3 bg-white hover:bg-slate-50/50 rounded-lg transition-colors mb-1 shadow-sm border border-slate-100" data-name=bhp.name.toLowerCase() data-room-id=bhp.roomId)
              div
                p(class="text-sm font-medium text-slate-900")= bhp.name
                p(class="text-xs text-slate-500 mt-0.5")= `Stok Tersedia: ${bhp.stock} ${bhp.unit || 'pcs'}`
              div(class="flex items-center gap-2")
                input(type="hidden" name=`bhpUsages[${index}][bhpId]` value=bhp.id)
                input(
                  type="number" 
                  name=`bhpUsages[${index}][quantity]` 
                  min="0" 
                  max=bhp.stock
                  placeholder="0" 
                  class="w-20 px-3 py-1.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 text-sm font-mono text-center font-semibold text-slate-800"
                )
                span(class="text-xs font-semibold text-slate-400 font-mono")= bhp.unit || 'pcs'
          div(id="bhp-empty-state" class="text-center py-6 text-slate-400 text-sm italic bg-white rounded-lg hidden")
            | Suku cadang / BHP tidak ditemukan.
        else
          div(class="text-center py-6 text-slate-400 text-sm italic bg-white rounded-lg")
            | Tidak ada data persediaan BHP di ruangan ini.

  script.
    (function() {
      const roomInput = document.getElementById('roomId');
      const assetsContainer = document.getElementById('assets-container');
      const assetRows = Array.from(document.querySelectorAll('.asset-row'));
      const assetsEmptyState = document.getElementById('assets-empty-state');
      
      const bhpSearchInput = document.getElementById('bhp-search');
      const bhpListContainer = document.getElementById('bhp-list-container');
      const bhpItems = Array.from(document.querySelectorAll('.bhp-item'));
      const bhpEmptyState = document.getElementById('bhp-empty-state');
      
      if (!roomInput) return;

      function updateUI() {
        const selectedRoomId = roomInput.value;
        if (!selectedRoomId) {
          assetsContainer.classList.add('hidden');
          // Hide BHPs
          bhpItems.forEach(item => {
            item.classList.remove('flex');
            item.classList.add('hidden');
          });
          return;
        }

        assetsContainer.classList.remove('hidden');

        // Filter assets
        let visibleAssets = 0;
        assetRows.forEach(row => {
          const rowRoomId = row.getAttribute('data-room-id');
          if (rowRoomId === selectedRoomId) {
            row.classList.remove('hidden');
            row.classList.add('grid');
            visibleAssets++;
          } else {
            row.classList.remove('grid');
            row.classList.add('hidden');
            // Uncheck checkbox for hidden assets so they are not submitted
            const chk = row.querySelector('input[type="checkbox"]');
            if (chk) {
              chk.checked = false;
              // Trigger change event to disable the conditionAfter select
              chk.dispatchEvent(new Event('change'));
            }
          }
        });

        if (visibleAssets === 0) {
          assetsEmptyState.classList.remove('hidden');
        } else {
          assetsEmptyState.classList.add('hidden');
        }

        // Filter BHPs by selected room and search query
        filterBHPs();
      }

      function filterBHPs() {
        const selectedRoomId = roomInput.value;
        const query = bhpSearchInput ? bhpSearchInput.value.toLowerCase().trim() : '';
        
        let visibleCount = 0;
        bhpItems.forEach(item => {
          const bhpRoomId = item.getAttribute('data-room-id');
          const name = item.getAttribute('data-name') || '';
          
          if (selectedRoomId && String(bhpRoomId) === String(selectedRoomId) && name.includes(query)) {
            item.classList.remove('hidden');
            item.classList.add('flex');
            visibleCount++;
          } else {
            item.classList.remove('flex');
            item.classList.add('hidden');
            // Reset quantity to empty/0 for hidden BHPs
            const qtyInput = item.querySelector('input[type="number"]');
            if (qtyInput) {
              qtyInput.value = '';
            }
          }
        });

        if (bhpEmptyState) {
          if (visibleCount === 0) {
            bhpEmptyState.classList.remove('hidden');
          } else {
            bhpEmptyState.classList.add('hidden');
          }
        }
      }

      // Add change listeners to checkboxes to toggle disable state on conditionAfter select dropdowns
      assetRows.forEach(row => {
        const chk = row.querySelector('input[type="checkbox"]');
        const selectAfter = row.querySelector('.asset-after-select');
        
        if (chk && selectAfter) {
          chk.addEventListener('change', function() {
            if (chk.checked) {
              selectAfter.disabled = false;
              selectAfter.classList.remove('opacity-50', 'cursor-not-allowed');
            } else {
              selectAfter.disabled = true;
              selectAfter.classList.add('opacity-50', 'cursor-not-allowed');
            }
          });
        }
      });

      // Listen to room select change
      roomInput.addEventListener('change', updateUI);

      // Listen to BHP search input
      if (bhpSearchInput) {
        bhpSearchInput.addEventListener('input', filterBHPs);
      }

      // Run initial setup (e.g. if room is pre-selected)
      updateUI();

      // Also support pre-checking a specific selectedInventoryId
      const targetInventoryId = '#{selectedInventoryId || ""}';
      if (targetInventoryId) {
        const targetRow = assetRows.find(r => r.getAttribute('data-asset-id') === targetInventoryId);
        if (targetRow) {
          const chk = targetRow.querySelector('input[type="checkbox"]');
          if (chk) {
            chk.checked = true;
            chk.dispatchEvent(new Event('change'));
          }
        }
      }
    })();

block crud_form_submit_label
  | Simpan Log Pemeliharaan
