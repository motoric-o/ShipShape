extends ../../layouts/crud_form.pug
include ../../components/forms/input.pug
include ../../components/forms/select.pug
include ../../components/forms/textarea.pug
include ../../components/forms/searchable_select.pug

block sidebar
  if sessionUser && sessionUser.userRole === 'ADMIN'
    include ../../components/sidebars/admin.pug
  else if sessionUser && sessionUser.userRole === 'KAPRODI'
    include ../../components/sidebars/kaprodi.pug
  else if sessionUser && sessionUser.userRole === 'KALAB'
    include ../../components/sidebars/kepala_lab.pug
  else if sessionUser && sessionUser.userRole === 'STAF_ADMIN'
    include ../../components/sidebars/staf_admin.pug
  else if sessionUser && sessionUser.userRole === 'STAF_LAB'
    include ../../components/sidebars/staf_lab.pug

block crud_form_title
  | Catat Log Pemeliharaan Aset

block crud_form_subtitle
  | Laporkan riwayat pemeliharaan, kalibrasi, perbaikan, dan penggunaan suku cadang/BHP.

block crud_form_fields
  if currentQuery && currentQuery.error
    div(class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 text-sm font-medium rounded-xl flex items-center gap-3 animate-pulse")
      svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z")
      span= currentQuery.error

  - 
    const inventoryOptions = (inventories || []).map(inv => ({
      value: inv.id,
      label: `${inv.name} (${inv.labelNumber || 'Belum Berlabel'})`
    }));
    const conditionOptions = [
      { value: 'GOOD', label: 'Baik (GOOD)' },
      { value: 'MAINTENANCE', label: 'Dalam Perawatan (MAINTENANCE)' },
      { value: 'BROKEN', label: 'Rusak (BROKEN)' },
      { value: 'DISPOSED', label: 'Dibuang/Dihapus (DISPOSED)' }
    ];
    const today = new Date().toISOString().split('T')[0];

  div(class="grid grid-cols-1 md:grid-cols-2 gap-6")
    +searchableSelectField("inventoryId", "inventoryId", "Pilih Barang / Aset", inventoryOptions, selectedInventoryId || '', true, "Cari barang / aset...")
    
    +selectField("conditionAfter", "conditionAfter", "Kondisi Setelah Tindakan", conditionOptions, 'GOOD', true)
    
    div(class="md:col-span-2")
      +inputField("maintenanceDate", "maintenanceDate", "Tanggal Tindakan Pemeliharaan", today, "date", "", true)
    
    div(class="md:col-span-2")
      +textareaField("description", "description", "Deskripsi Tindakan & Detail Perbaikan", '', "Jelaskan kerusakan awal, perbaikan yang dilakukan, dan detail solusi teknis...", 4, true)
    
    // BHP usages selection
    div(class="md:col-span-2 space-y-3")
      div(class="flex flex-col sm:flex-row sm:items-center justify-between gap-3")
        div
          label(class="text-sm font-semibold text-slate-800 block") Suku Cadang / BHP yang Digunakan (Opsional)
          p(class="text-xs text-slate-500") Tentukan jumlah suku cadang atau bahan habis pakai yang dikonsumsi selama pemeliharaan ini.
        if bhps && bhps.length > 0
          div(class="w-full sm:w-64 relative flex items-center")
            input(
              type="text"
              id="bhp-search"
              placeholder="Cari suku cadang / BHP..."
              class="w-full pl-9 pr-3 py-1.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 transition-colors bg-white text-sm"
            )
            div(class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none")
              svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
      
      div(class="max-h-60 overflow-y-auto border border-slate-200 rounded-xl divide-y divide-slate-100 bg-slate-50 p-2" id="bhp-list-container")
        if bhps && bhps.length > 0
          each bhp, index in bhps
            div(class="bhp-item flex items-center justify-between gap-4 p-3 bg-white hover:bg-slate-50/50 rounded-lg transition-colors mb-1 shadow-sm border border-slate-100" data-name=bhp.name.toLowerCase())
              div
                p(class="text-sm font-medium text-slate-900")= bhp.name
                p(class="text-xs text-slate-500 mt-0.5")= `Stok Tersedia: ${bhp.stock} ${bhp.unit || 'pcs'}`
              div(class="flex items-center gap-2")
                input(type="hidden" name=`bhpUsages[${index}][bhpId]` value=bhp.id)
                input(
                  type="number" 
                  name=`bhpUsages[${index}][quantity]` 
                  min="0" 
                  max=bhp.stock
                  placeholder="0" 
                  class="w-20 px-3 py-1.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-green-500 text-sm font-mono text-center font-semibold text-slate-800"
                )
                span(class="text-xs font-semibold text-slate-400 font-mono")= bhp.unit || 'pcs'
          div(id="bhp-empty-state" class="text-center py-6 text-slate-400 text-sm italic bg-white rounded-lg hidden")
            | Suku cadang / BHP tidak ditemukan.
        else
          div(class="text-center py-6 text-slate-400 text-sm italic bg-white rounded-lg")
            | Tidak ada data persediaan BHP di ruangan ini.

  script.
    (function() {
      const searchInput = document.getElementById('bhp-search');
      const listContainer = document.getElementById('bhp-list-container');
      
      if (!searchInput || !listContainer) return;
      
      const bhpItems = Array.from(listContainer.getElementsByClassName('bhp-item'));
      const emptyState = document.getElementById('bhp-empty-state');
      
      searchInput.addEventListener('input', function() {
        const query = searchInput.value.toLowerCase().trim();
        let visibleCount = 0;
        
        bhpItems.forEach(item => {
          const name = item.getAttribute('data-name');
          if (name.includes(query)) {
            item.classList.remove('hidden');
            item.classList.add('flex');
            visibleCount++;
          } else {
            item.classList.remove('flex');
            item.classList.add('hidden');
          }
        });
        
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      });
    })();

block crud_form_submit_label
  | Simpan Log Pemeliharaan
