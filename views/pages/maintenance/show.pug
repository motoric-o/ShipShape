extends ../../layouts/main.pug

block sidebar
  if sessionUser && sessionUser.userRole === 'ADMIN'
    include ../../components/sidebars/admin.pug
  else if sessionUser && sessionUser.userRole === 'KAPRODI'
    include ../../components/sidebars/kaprodi.pug
  else if sessionUser && sessionUser.userRole === 'KALAB'
    include ../../components/sidebars/kepala_lab.pug
  else if sessionUser && sessionUser.userRole === 'STAF_ADMIN'
    include ../../components/sidebars/staf_admin.pug
  else if sessionUser && sessionUser.userRole === 'STAF_LAB'
    include ../../components/sidebars/staf_lab.pug

block content
  div(class="max-w-4xl mx-auto space-y-6")
    // Back navigation
    div(class="flex items-center gap-3")
      a(href="/maintenance" class="text-slate-400 hover:text-slate-600 transition-colors")
        svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18")
      div
        h1(class="text-2xl font-bold text-slate-900")
          = `Detail Pemeliharaan #${log.id}`
        p(class="text-sm text-slate-500 mt-1") Audit detail log perawatan aset laboratorium.

    div(class="grid grid-cols-1 md:grid-cols-3 gap-6")
      // Left/Main detail card
      div(class="md:col-span-2 space-y-6")
        div(class="bg-white rounded-xl border border-slate-200 p-6 md:p-8 shadow-sm space-y-6")
          div(class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 pb-4")
            div
              p(class="text-xs font-bold uppercase tracking-wider text-slate-400") Tanggal Tindakan
              p(class="text-sm font-semibold text-slate-700 mt-1")
                = new Date(log.maintenanceDate || log.createdAt).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })
            div
              p(class="text-xs font-bold uppercase tracking-wider text-slate-400 text-right") Kondisi Setelahnya
              div(class="mt-1 text-right")
                if log.conditionAfter === 'GOOD'
                  span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200") BAIK
                else if log.conditionAfter === 'MAINTENANCE'
                  span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200") PERAWATAN
                else if log.conditionAfter === 'BROKEN'
                  span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800 border border-red-200") RUSAK
                else if log.conditionAfter === 'DISPOSED'
                  span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200") DIBUANG

          div(class="space-y-2")
            h3(class="text-xs font-bold uppercase tracking-wider text-slate-400") Deskripsi Tindakan &amp; Catatan Teknis
            p(class="text-slate-800 text-sm leading-relaxed bg-slate-50 p-4 rounded-xl border border-slate-200/50 min-h-[120px] whitespace-pre-wrap")= log.description

          div(class="pt-4 border-t border-slate-100 flex items-center gap-4")
            div(class="w-10 h-10 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-600 font-bold")
              = log.performedBy && log.performedBy.name ? log.performedBy.name.charAt(0).toUpperCase() : 'U'
            div
              p(class="text-xs font-bold uppercase tracking-wider text-slate-400") Teknisi Pelaksana
              p(class="text-sm font-semibold text-slate-900 mt-0.5")= log.performedBy ? log.performedBy.name : 'Unknown User'
              p(class="text-xs text-slate-500")= log.performedBy ? log.performedBy.email : ''

      // Right sidebar details card (Asset & BHP Usages)
      div(class="space-y-6")
        // Asset card
        div(class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm space-y-4")
          h3(class="text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-2") Informasi Aset
          if log.inventory
            div(class="space-y-3")
              div
                p(class="text-xs text-slate-400") Nama Aset
                p(class="text-sm font-semibold text-slate-800")= log.inventory.name
              div
                p(class="text-xs text-slate-400") Nomor Label
                p(class="text-sm font-mono font-semibold text-green-700 mt-0.5")
                  = log.inventory.labelNumber || 'Belum Berlabel'
              div
                p(class="text-xs text-slate-400") Lokasi Ruang
                p(class="text-sm font-medium text-slate-700")= log.inventory.room ? log.inventory.room.name : 'Unknown'
          else
            p(class="text-sm text-slate-400 italic") Aset ini telah dihapus dari sistem.

        // BHP usages card
        div(class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm space-y-4")
          h3(class="text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-2") BHP yang Digunakan
          if log.bhpUsages && log.bhpUsages.length > 0
            ul(class="divide-y divide-slate-100")
              each usage in log.bhpUsages
                li(class="py-2.5 flex items-center justify-between gap-3 text-sm")
                  div(class="font-medium text-slate-800")= usage.bhp ? usage.bhp.name : 'Unknown BHP'
                  div(class="text-slate-500 font-semibold font-mono")
                    = `${usage.quantity} ${usage.bhp ? usage.bhp.unit : 'pcs'}`
          else
            div(class="text-center py-4 text-slate-400 text-xs italic")
              svg(xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mx-auto text-slate-300 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4")
              | Tidak ada penggunaan BHP.
