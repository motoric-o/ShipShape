extends ../../layouts/main.pug

block sidebar
  if sessionUser && sessionUser.userRole === 'ADMIN'
    include ../../components/sidebars/admin.pug
  else if sessionUser && sessionUser.userRole === 'KAPRODI'
    include ../../components/sidebars/kaprodi.pug
  else if sessionUser && sessionUser.userRole === 'KALAB'
    include ../../components/sidebars/kepala_lab.pug
  else if sessionUser && sessionUser.userRole === 'STAF_ADMIN'
    include ../../components/sidebars/staf_admin.pug
  else if sessionUser && sessionUser.userRole === 'STAF_LAB'
    include ../../components/sidebars/staf_lab.pug

block content
  div(class="max-w-4xl mx-auto space-y-6")
    // Back navigation
    div(class="flex items-center gap-3")
      a(href="/maintenance" class="text-slate-400 hover:text-slate-600 transition-colors")
        svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18")
      div
        h1(class="text-2xl font-bold text-slate-900")
          = `Detail Pemeliharaan #${log.id}`
        p(class="text-sm text-slate-500 mt-1") Audit detail log perawatan aset laboratorium.

    div(class="grid grid-cols-1 md:grid-cols-3 gap-6")
      // Left/Main detail cards
      div(class="md:col-span-2 space-y-6")
        // Card 1: Description & Technical Notes
        div(class="bg-white rounded-xl border border-slate-200 p-6 md:p-8 shadow-sm space-y-4")
          h3(class="text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-2") Deskripsi Tindakan &amp; Catatan Teknis
          p(class="text-slate-800 text-sm leading-relaxed bg-slate-50 p-4 rounded-xl border border-slate-200/50 min-h-[100px] whitespace-pre-wrap")= log.description

        // Card 2: Maintained Assets & BHP Usages
        div(class="bg-white rounded-xl border border-slate-200 p-6 md:p-8 shadow-sm space-y-6")
          h3(class="text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-2") Aset &amp; Suku Cadang yang Digunakan
          if log.items && log.items.length > 0
            div(class="space-y-6")
              each item, idx in log.items
                div(class="p-4 rounded-xl border border-slate-150 bg-slate-50/30 space-y-4")
                  // Asset Header Info
                  div(class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-3")
                    div
                      h4(class="text-sm font-semibold text-slate-900")= item.inventory ? item.inventory.name : 'Aset Dihapus'
                      if item.inventory && item.inventory.labelNumber
                        span(class="text-[10px] font-mono text-green-700 bg-green-50 border border-green-200/50 px-1.5 py-0.5 rounded font-semibold mt-1 inline-block")= item.inventory.labelNumber
                      if item.inventory && item.inventory.room
                        span(class="text-[10px] text-slate-500 ml-2 inline-block")= `Ruang: ${item.inventory.room.name}`
                    div
                      if item.conditionAfter === 'GOOD'
                        span(class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-green-100 text-green-800 border border-green-200") BAIK
                      else if item.conditionAfter === 'MAINTENANCE'
                        span(class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-100 text-amber-800 border border-amber-200") PERAWATAN
                      else if item.conditionAfter === 'BROKEN'
                        span(class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-red-100 text-red-800 border border-red-200") RUSAK
                      else if item.conditionAfter === 'DISPOSED'
                        span(class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200") DIBUANG

                  // BHP Usages list for this item
                  div(class="space-y-2")
                    p(class="text-[10px] font-bold uppercase tracking-wider text-slate-400") Suku Cadang / BHP yang Dikonsumsi
                    if item.bhpUsages && item.bhpUsages.length > 0
                      ul(class="divide-y divide-slate-150 border border-slate-200 rounded-lg bg-white overflow-hidden")
                        each usage in item.bhpUsages
                          li(class="px-3 py-2 flex items-center justify-between gap-3 text-xs")
                            div(class="font-medium text-slate-800")= usage.bhp ? usage.bhp.name : 'Unknown BHP'
                            div(class="text-slate-500 font-semibold font-mono")
                              = `${usage.quantity} ${usage.bhp ? usage.bhp.unit : 'pcs'}`
                    else
                      p(class="text-xs text-slate-400 italic bg-white p-2 rounded-lg border border-slate-200 border-dashed text-center") Tidak ada penggunaan suku cadang/BHP untuk aset ini.
          else
            p(class="text-sm text-slate-400 italic text-center py-6") Tidak ada aset yang terdaftar dalam pemeliharaan ini.

      // Right sidebar card (Session Meta)
      div(class="space-y-6")
        div(class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm space-y-4")
          h3(class="text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-2") Informasi Umum
          div(class="space-y-3.5")
            div
              p(class="text-xs text-slate-400 font-medium") Tanggal Tindakan
              p(class="text-sm font-semibold text-slate-700 mt-1")
                = new Date(log.maintenanceDate || log.createdAt).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })
            div(class="pt-3.5 border-t border-slate-100")
              p(class="text-xs text-slate-400 font-medium") Teknisi Pelaksana
              div(class="flex items-center gap-3 mt-2")
                div(class="w-8 h-8 rounded-full bg-green-50 border border-green-200 flex items-center justify-center text-green-700 font-bold text-xs")
                  = log.performedBy && log.performedBy.name ? log.performedBy.name.charAt(0).toUpperCase() : 'U'
                div
                  p(class="text-xs font-semibold text-slate-900")= log.performedBy ? log.performedBy.name : 'Unknown User'
                  p(class="text-[10px] text-slate-500")= log.performedBy ? log.performedBy.email : ''
