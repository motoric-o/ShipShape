extends ../../layouts/main.pug

block sidebar
  if sessionUser && sessionUser.userRole === 'ADMIN'
    include ../../components/sidebars/admin.pug

block content
  div(class="max-w-6xl mx-auto space-y-6")
    //- Error & Success Messages
    if currentQuery && currentQuery.error
      div(class="p-4 bg-red-50 border border-red-200 text-red-700 text-sm font-medium rounded-xl flex items-center gap-3 animate-pulse")
        svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z")
        span= currentQuery.error
    if currentQuery && currentQuery.success
      div(class="p-4 bg-green-50 border border-green-200 text-green-700 text-sm font-medium rounded-xl flex items-center gap-3")
        svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z")
        span= currentQuery.success

    //- Back and Rollback Action Row
    div(class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4")
      div
        a(href="/admin/activity-log" class="inline-flex items-center text-sm font-medium text-slate-500 hover:text-slate-800 transition-colors")
          svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18")
          | Kembali ke Daftar Log
        h1(class="text-2xl font-bold text-slate-900 mt-2") Detail & Perbandingan Log
        p(class="text-sm text-slate-500") ID Log: ##{log.id}
      
      if log.action !== 'ROLLBACK'
        div(class="shrink-0")
          form(action=`/admin/activity-log/${log.id}/rollback` method="POST" onsubmit="return confirm('Apakah Anda yakin ingin melakukan rollback ke versi sebelumnya? Ini akan menimpa data versi aktif sekarang.');")
            button(type="submit" class="inline-flex items-center justify-center bg-orange-600 hover:bg-orange-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 cursor-pointer")
              svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6")
              | Rollback Data

    //- Meta Cards
    div(class="grid grid-cols-1 md:grid-cols-4 gap-4 bg-white border border-slate-200/80 rounded-xl p-6 shadow-sm")
      div(class="space-y-1")
        span(class="text-xs font-bold text-slate-400 uppercase tracking-wider") Aksi
        div
          if log.action === 'CREATE'
            span(class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-green-50 text-green-700 border border-green-100") CREATE
          else if log.action === 'UPDATE'
            span(class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-100") UPDATE
          else if log.action === 'DELETE'
            span(class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-red-50 text-red-700 border border-red-100") DELETE
          else if log.action === 'ROLLBACK'
            span(class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-orange-50 text-orange-700 border border-orange-100") ROLLBACK
      
      div(class="space-y-1")
        span(class="text-xs font-bold text-slate-400 uppercase tracking-wider") Dilakukan Oleh
        div(class="text-sm font-semibold text-slate-800")= log.user ? log.user.name : 'System'
        div(class="text-xs text-slate-500")= log.user ? log.user.email : 'System level action'

      div(class="space-y-1")
        span(class="text-xs font-bold text-slate-400 uppercase tracking-wider") Target Entitas
        div(class="text-sm font-semibold text-slate-800")= log.entityType
        div(class="text-xs text-slate-500") ID Entitas: #{log.entityId}

      div(class="space-y-1")
        span(class="text-xs font-bold text-slate-400 uppercase tracking-wider") Waktu Kejadian
        div(class="text-sm font-semibold text-slate-800")
          = new Date(log.createdAt).toLocaleString('id-ID', {day: '2-digit', month: 'long', year: 'numeric'})
        div(class="text-xs text-slate-500")
          = new Date(log.createdAt).toLocaleTimeString('id-ID', {hour: '2-digit', minute: '2-digit', second: '2-digit'})

    //- Comparison Table Card
    div(class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden")
      div(class="border-b border-slate-200 bg-slate-50 px-6 py-4 flex items-center justify-between")
        h2(class="text-lg font-bold text-slate-900") Perbandingan Nilai Atribut
        span(class="text-xs font-medium text-amber-700 bg-amber-50 px-2.5 py-1 rounded border border-amber-100/50")
          | Baris berwarna oranye menandakan perubahan nilai
      
      div(class="overflow-x-auto")
        table(class="w-full text-left border-collapse table-fixed")
          thead
            tr(class="bg-slate-50/50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider")
              th(class="px-6 py-3 w-1/4") Atribut / Kolom
              th(class="px-6 py-3 w-3/8") Versi Sebelumnya (Old)
              th(class="px-6 py-3 w-3/8") Versi Setelahnya (New)
          tbody(class="divide-y divide-slate-100")
            if diff && diff.length > 0
              each item in diff
                tr(class=item.isDifferent ? 'bg-amber-50/20 font-medium' : '')
                  td(class="px-6 py-4 text-sm font-semibold text-slate-700 border-r border-slate-100")= item.key
                  
                  //- Old Value
                  td(class=`px-6 py-4 text-xs font-mono whitespace-pre-wrap break-all border-r border-slate-100 ${item.isDifferent ? 'bg-red-50/60 text-red-700 font-semibold' : 'text-slate-600'}`)
                    if item.oldValue !== undefined && item.oldValue !== null
                      if typeof item.oldValue === 'object'
                        = JSON.stringify(item.oldValue, null, 2)
                      else
                        = item.oldValue
                    else
                      span(class="text-slate-400/70 italic") null
                  
                  //- New Value
                  td(class=`px-6 py-4 text-xs font-mono whitespace-pre-wrap break-all ${item.isDifferent ? 'bg-green-50/60 text-green-700 font-semibold' : 'text-slate-600'}`)
                    if item.newValue !== undefined && item.newValue !== null
                      if typeof item.newValue === 'object'
                        = JSON.stringify(item.newValue, null, 2)
                      else
                        = item.newValue
                    else
                      span(class="text-slate-400/70 italic") null
            else
              tr
                td(colspan="3" class="px-6 py-12 text-center text-slate-400 italic") Tidak ada data atribut untuk dibandingkan.
