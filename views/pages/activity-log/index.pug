extends ../../layouts/crud_index.pug
include ../../components/forms/select.pug
include ../../components/forms/filter_bar.pug

block sidebar
  if sessionUser && sessionUser.userRole === 'ADMIN'
    include ../../components/sidebars/admin.pug

block crud_title
  | Log Aktivitas

block crud_subtitle
  | Rekam jejak pembuatan, pembaruan, penghapusan, dan rollback data entitas sistem.

block crud_search
  - const hasActiveFilters = selectedEntityType || selectedAction
  - const isAdvancedOpened = selectedEntityType || selectedAction

  +filterBar("/admin/activity-log", "Cari log...", isAdvancedOpened, "/admin/activity-log", hasActiveFilters, null, '', 'grid-cols-1 sm:grid-cols-2 gap-4')
    //- Entity Type Filter
    - 
      const entityFilterOptions = [
        { value: '', label: 'Semua Tipe Entitas' },
        ...(entityTypes || []).map(t => ({ value: t, label: t }))
      ]
    div(class="space-y-1.5")
      label(class="text-xs font-semibold text-slate-500 uppercase tracking-wider") Tipe Entitas
      +selectField("entityType", "entityType", null, entityFilterOptions, selectedEntityType || '', false, "py-2 pl-3 pr-10 bg-white min-w-full")

    //- Action Filter
    - 
      const actionFilterOptions = [
        { value: '', label: 'Semua Aksi' },
        ...(actions || []).map(a => ({ value: a, label: a }))
      ]
    div(class="space-y-1.5")
      label(class="text-xs font-semibold text-slate-500 uppercase tracking-wider") Tipe Aksi
      +selectField("action", "action", null, actionFilterOptions, selectedAction || '', false, "py-2 pl-3 pr-10 bg-white min-w-full")

block crud_create_button
  // No create button since log entries are system-generated only

block crud_table_headers
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Waktu
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Pengguna
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Entitas
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") ID Entitas
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Aksi
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right") Detail

block crud_table_rows
  if logs && logs.length > 0
    each log in logs
      tr(class="hover:bg-slate-50/50 transition-colors group")
        td(class="px-6 py-4 whitespace-nowrap text-sm text-slate-600 font-medium")
          = new Date(log.createdAt).toLocaleString('id-ID', {day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit'})
        td(class="px-6 py-4 whitespace-nowrap")
          div(class="flex items-center")
            div(class="h-8 w-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 font-bold text-xs mr-2")
              = log.user ? log.user.name.charAt(0).toUpperCase() : 'S'
            div(class="text-sm font-medium text-slate-900")= log.user ? log.user.name : 'System'
        td(class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-slate-700")= log.entityType
        td(class="px-6 py-4 whitespace-nowrap text-sm text-slate-500")= log.entityId
        td(class="px-6 py-4 whitespace-nowrap")
          if log.action === 'CREATE'
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-100") CREATE
          else if log.action === 'UPDATE'
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-100") UPDATE
          else if log.action === 'DELETE'
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-100") DELETE
          else if log.action === 'ROLLBACK'
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-orange-50 text-orange-700 border border-orange-100") ROLLBACK
        td(class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium")
          a(href=`/admin/activity-log/${log.id}` class="inline-flex items-center text-green-600 hover:text-green-900 bg-green-50 hover:bg-green-100 px-3 py-1 rounded-lg transition-colors" title="Lihat Perbandingan")
            svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z")
            | Bandingkan
