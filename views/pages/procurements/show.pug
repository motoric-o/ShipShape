extends ../../layouts/main.pug

block sidebar
  if sessionUser && sessionUser.userRole === 'ADMIN'
    include ../../components/sidebars/admin.pug
  else if sessionUser && sessionUser.userRole === 'KAPRODI'
    include ../../components/sidebars/kaprodi.pug
  else if sessionUser && sessionUser.userRole === 'KALAB'
    include ../../components/sidebars/kepala_lab.pug
  else if sessionUser && sessionUser.userRole === 'STAF_ADMIN'
    include ../../components/sidebars/staf_admin.pug
  else if sessionUser && sessionUser.userRole === 'STAF_LAB'
    include ../../components/sidebars/staf_lab.pug

block content
  div(class="max-w-7xl mx-auto space-y-6 pb-12" id="draft-container" data-draft-id=draft.id data-draft-status=draft.status)
    //- Breadcrumb & Back Button
    div(class="flex flex-wrap items-center justify-between gap-4")
      div(class="flex items-center gap-3")
        a(href="/procurements" class="text-slate-400 hover:text-slate-600 transition-colors p-2 hover:bg-slate-100 rounded-xl")
          svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18")
        div
          div(class="flex items-center gap-2.5")
            h1(class="text-2xl font-extrabold text-slate-900") Detail &amp; Review Pengadaan
            //- Real-time Draft Status Badge
            span#draft-status-badge(class=`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold border transition-all ${draft.status === 'APPROVED' ? 'bg-green-50 text-green-700 border-green-200' : (draft.status === 'PENDING_REVIEW' || draft.status === 'LOCKED' ? 'bg-orange-50 text-orange-700 border-orange-200' : 'bg-slate-50 text-slate-700 border-slate-200')}`)
              if draft.status === 'APPROVED'
                | DISETUJUI &amp; FINAL
              else if draft.status === 'PENDING_REVIEW' || draft.status === 'LOCKED'
                | MENUNGGU REVIEW
              else
                = draft.status
          p(class="text-sm text-slate-500 mt-1")
            | Tinjau pengajuan inventaris dan BHP yang diajukan oleh Kepala Laboratorium.

      //- Status Banner if Finalized
      if draft.status === 'APPROVED'
        div(class="flex items-center gap-2 bg-green-50 border border-green-200/80 px-4 py-2.5 rounded-2xl shadow-sm text-green-800 font-semibold text-sm")
          svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z")
          | Draf Terkunci (Read-Only)

    //- Toast Notification Banner
    div#notification-banner(class="hidden fixed z-50 min-w-[320px] max-w-lg p-4 rounded-xl border flex items-center justify-between shadow-xl animate-fade-in transition-all duration-300" style="top: 6rem; right: 1.5rem;")
      span#notification-text(class="text-sm font-medium")
      button(onclick="closeNotification()" class="text-slate-400 hover:text-slate-600 ml-4 shrink-0")
        svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12")

    //- Grid: Info & Summary Cards
    div(class="grid grid-cols-1 lg:grid-cols-3 gap-6")
      //- Left Info Card (2 cols)
      div(class="lg:col-span-2 bg-white border border-slate-200 p-6 rounded-2xl shadow-sm space-y-4 relative overflow-hidden")
        div(class="absolute top-0 right-0 w-48 h-48 bg-slate-500/5 rounded-full blur-3xl")
        h2(class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2")
          svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z")
          | Informasi Pengajuan
        
        div(class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm")
          div
            p(class="text-slate-400 font-medium") Judul Usulan
            p(class="text-slate-900 font-semibold mt-0.5 text-base")= draft.title
          div
            p(class="text-slate-400 font-medium") Tahun Akademik
            p(class="text-slate-900 font-semibold mt-0.5 text-base")= draft.year
          div
            p(class="text-slate-400 font-medium") Pengaju (Kepala Lab)
            p(class="text-slate-900 font-semibold mt-0.5")= draft.createdBy ? draft.createdBy.name : 'Unknown'
            p(class="text-xs text-slate-400")= draft.createdBy ? draft.createdBy.email : ''
          div
            p(class="text-slate-400 font-medium") Tanggal Pengajuan
            p(class="text-slate-900 font-semibold mt-0.5")
              = new Date(draft.createdAt).toLocaleDateString('id-ID', {day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit'})

      //- Right Budget / Progress Summary Card (1 col)
      div(class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm flex flex-col justify-between relative overflow-hidden")
        div(class="absolute top-0 right-0 w-32 h-32 bg-green-500/5 rounded-full blur-2xl")
        div(class="space-y-4")
          h2(class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2")
            svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 11h.01M12 7h.01M15 10h.01M15 7h.01M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z")
            | Ringkasan Draf
          
          div(class="flex justify-between items-baseline")
            span(class="text-sm text-slate-500 font-medium") Estimasi Total Anggaran
            - var totalBudget = draft.items ? draft.items.reduce((sum, item) => sum + (item.price * item.quantity), 0) : 0
            span#total-budget-label(class="text-2xl font-extrabold text-slate-900")
              = 'Rp ' + totalBudget.toLocaleString('id-ID')
          
          //- Decided items counts progress bar
          - var totalItems = draft.items ? draft.items.length : 0
          - var approvedCount = draft.items ? draft.items.filter(i => i.status === 'APPROVED').length : 0
          - var rejectedCount = draft.items ? draft.items.filter(i => i.status === 'REJECTED').length : 0
          - var pendingCount = draft.items ? draft.items.filter(i => i.status === 'PENDING').length : 0
          
          div(class="space-y-2 mt-4")
            div(class="flex justify-between text-xs font-semibold")
              span(class="text-slate-500") Ulasan Item Selesai
              span#progress-fraction(class="text-slate-800")
                span(class="text-green-600 font-bold")
                  span#approved-count-label= approvedCount
                  |  Disetujui
                span(class="text-slate-400 mx-1") /
                span(class="text-red-600 font-bold")
                  span#rejected-count-label= rejectedCount
                  |  Ditolak
                span(class="text-slate-400 ml-1") (
                span(class="text-amber-500 font-bold")
                  span#pending-count-label= pendingCount
                  |  Pending
                span(class="text-slate-400") )
            div(class="relative w-full bg-slate-100 rounded-full h-2.5 overflow-hidden")
              - var appPctInit = totalItems > 0 ? (approvedCount / totalItems) * 100 : 0
              - var rejPctInit = totalItems > 0 ? (rejectedCount / totalItems) * 100 : 0
              - var penPctInit = totalItems > 0 ? (pendingCount / totalItems) * 100 : 0
              div#approved-bar(class="absolute top-0 left-0 bg-green-500 h-full transition-all duration-500" style=`width: ${appPctInit}%`)
              div#rejected-bar(class="absolute top-0 bg-red-500 h-full transition-all duration-500" style=`left: ${appPctInit}%; width: ${rejPctInit}%`)
              div#pending-bar(class="absolute top-0 bg-slate-200 h-full transition-all duration-500" style=`left: ${appPctInit + rejPctInit}%; width: ${penPctInit}%`)

    //- Items Table Card
    div(class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden")
      div(class="px-6 py-5 border-b border-slate-200/80 flex flex-wrap items-center justify-between gap-4 bg-slate-50/50")
        div
          h2(class="text-lg font-bold text-slate-900") Item Barang yang Diusulkan
          p(class="text-xs text-slate-500 mt-0.5") Kaprodi harus meninjau dan memilih status setuju/tolak per barang secara individu.
        
        //- Stats pill
        div(class="flex items-center gap-1.5 bg-white border border-slate-200 px-3 py-1 rounded-xl shadow-xs text-xs font-semibold text-slate-600")
          span(class="w-2 h-2 rounded-full bg-green-500")
          span#table-total-count= totalItems
          |  Total Barang

      div(class="overflow-x-auto")
        table(class="w-full text-left border-collapse" id="items-table")
          thead
            tr(class="bg-slate-50/80 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider")
              th(class="px-6 py-4 min-w-[250px]") Nama Barang
              th(class="px-6 py-4 whitespace-nowrap") Tipe
              th(class="px-6 py-4 text-right whitespace-nowrap") Harga Satuan
              th(class="px-6 py-4 text-center whitespace-nowrap") Qty
              th(class="px-6 py-4 text-right whitespace-nowrap") Total Estimasi
              th(class="px-6 py-4 min-w-[200px]") Catatan Penggantian
              th(class="px-6 py-4 whitespace-nowrap") Link Toko
              th(class="px-6 py-4 text-center w-40 whitespace-nowrap") Status Ulasan
              if sessionUser && (sessionUser.userRole === 'KAPRODI' || sessionUser.userRole === 'ADMIN')
                th(class="px-6 py-4 text-center w-56 whitespace-nowrap") Aksi Keputusan
          
          tbody(class="divide-y divide-slate-100 text-sm")
            if draft.items && draft.items.length > 0
              each item in draft.items
                tr(class="hover:bg-slate-50/50 transition-colors group" id=`item-row-${item.id}` data-item-id=item.id data-item-status=item.status data-item-price=item.price data-item-qty=item.quantity)
                  td(class="px-6 py-4")
                    div(class="font-semibold text-slate-800")= item.name
                    div(class="text-xs text-slate-400 mt-0.5") ID: ##{item.id}
                  td(class="px-6 py-4 whitespace-nowrap")
                    if item.type === 'INVENTORY'
                      span(class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-lg text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-100")
                        svg(xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4")
                        | INVENTARIS
                    else
                      span(class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-lg text-xs font-semibold bg-teal-50 text-teal-700 border border-teal-100")
                        svg(xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z")
                        | BHP
                  td(class="px-6 py-4 text-right whitespace-nowrap font-medium text-slate-600")
                    = 'Rp ' + item.price.toLocaleString('id-ID')
                  td(class="px-6 py-4 text-center whitespace-nowrap font-semibold text-slate-700")= item.quantity
                  td(class="px-6 py-4 text-right whitespace-nowrap font-bold text-slate-800")
                    = 'Rp ' + (item.price * item.quantity).toLocaleString('id-ID')
                  td(class="px-6 py-4")
                    if item.replacedInventory
                      div(class="text-xs text-slate-700 font-medium") Mengganti Aset Rusak:
                      a(href=`/inventory/${item.replacedInventory.id}` class="text-xs text-orange-600 hover:text-orange-800 hover:underline font-semibold block mt-0.5")
                        = item.replacedInventory.name
                        if item.replacedInventory.labelNumber
                          |  (#{item.replacedInventory.labelNumber})
                    else
                      span(class="text-xs text-slate-400 italic") - Tidak ada penggantian
                  td(class="px-6 py-4")
                    if item.link
                      a(href=item.link target="_blank" class="inline-flex items-center text-xs text-blue-600 hover:text-blue-800 font-semibold hover:underline gap-1")
                        svg(xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14")
                        | Link Produk
                    else
                      span(class="text-xs text-slate-400 italic") - Tidak ada link
                  td(class="px-6 py-4 text-center whitespace-nowrap")
                    span(class=`status-pill inline-flex justify-center w-32 items-center px-2.5 py-1 rounded-full text-xs font-semibold border transition-all ${item.status === 'APPROVED' ? 'bg-green-50 text-green-700 border-green-200' : (item.status === 'REJECTED' ? 'bg-red-50 text-red-700 border-red-200' : 'bg-amber-50 text-amber-700 border-amber-200')}`)
                      = item.status === 'APPROVED' ? 'DISETUJUI' : (item.status === 'REJECTED' ? 'DITOLAK' : 'PENDING')
                  
                  if sessionUser && (sessionUser.userRole === 'KAPRODI' || sessionUser.userRole === 'ADMIN')
                    td(class="px-6 py-4 text-center whitespace-nowrap")
                      div(class="flex items-center justify-center gap-1.5 btn-decision-group")
                        //- Approve Button
                        button(
                          type="button" 
                          onclick=`decideItem(${item.id}, 'APPROVED')` 
                          disabled=(draft.status === 'APPROVED') 
                          class=`btn-approve px-3 py-1.5 rounded-lg text-xs font-bold tracking-wide border transition-all flex items-center gap-1 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed ${item.status === 'APPROVED' ? 'bg-green-600 border-green-600 text-white shadow-sm shadow-green-600/20' : 'bg-white border-slate-200 text-slate-600 hover:border-green-300 hover:bg-green-50 hover:text-green-700'}`
                        )
                          svg(xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7")
                          | Setuju

                        //- Reject Button
                        button(
                          type="button" 
                          onclick=`decideItem(${item.id}, 'REJECTED')` 
                          disabled=(draft.status === 'APPROVED') 
                          class=`btn-reject px-3 py-1.5 rounded-lg text-xs font-bold tracking-wide border transition-all flex items-center gap-1 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed ${item.status === 'REJECTED' ? 'bg-red-600 border-red-600 text-white shadow-sm shadow-red-600/20' : 'bg-white border-slate-200 text-slate-600 hover:border-red-300 hover:bg-red-50 hover:text-red-700'}`
                        )
                          svg(xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12")
                          | Tolak
            else
              tr
                td(colspan="9" class="px-6 py-8 text-center text-slate-500 bg-white")
                  p Tidak ada item barang di dalam draf pengadaan ini.

    //- Bottom Decision/Finalization Banner for Kaprodi
    if sessionUser && (sessionUser.userRole === 'KAPRODI' || sessionUser.userRole === 'ADMIN')
      div#finalization-box(class=`bg-white border p-6 rounded-2xl shadow-sm flex flex-col md:flex-row md:items-center md:justify-between gap-6 transition-all ${draft.status === 'APPROVED' ? 'border-green-200 bg-green-50/10' : 'border-slate-200'}`)
        div(class="space-y-1.5")
          h3(class="text-base font-bold text-slate-900") Finalisasi Seluruh Draf Pengadaan
          p(class="text-sm text-slate-500")
            | Pastikan Anda telah meninjau item per item. Setelah finalisasi dikirimkan, seluruh keputusan item dan status draf tidak dapat diubah lagi.
        div(class="flex items-center gap-3 shrink-0")
          //- Finalize Draft Button
          button(
            type="button" 
            id="btn-finalize-draft"
            onclick="openFinalizeModal()" 
            disabled=(draft.status === 'APPROVED')
            class="px-6 py-3 bg-slate-900 rounded-xl text-sm font-semibold text-white shadow-md shadow-slate-900/10 hover:bg-green-600 hover:shadow-green-600/20 disabled:opacity-40 disabled:bg-slate-300 disabled:shadow-none disabled:cursor-not-allowed transition-all duration-300 transform active:scale-95"
          )
            div(class="flex items-center gap-2")
              svg(xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7")
              span Finalisasi &amp; Kunci Draf

  //- PREMIUM SWEETALERT-STYLE OVERLAYS (Confirmation, Success, Warning Modals)
  
  //- 1. Confirmation Modal
  div#finalize-modal(class="hidden fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true")
    //- Backdrop blur overlay
    div(class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm transition-all duration-300 animate-backdrop-fade" aria-hidden="true" onclick="closeFinalizeModal()")
    
    //- Centered modal container
    div(class="fixed inset-0 z-50 flex items-center justify-center p-4")
      div(class="relative bg-white rounded-3xl text-center shadow-2xl border border-slate-100 p-6 md:p-8 max-w-md w-full animate-modal-enter flex flex-col items-center")
        //- Premium SweetAlert Warning Icon
        div(class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-amber-50 text-amber-500 mb-5 border border-amber-100 shadow-inner")
          svg(xmlns="http://www.w3.org/2000/svg" class="h-11 w-11 animate-pulse mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z")
        
        h3#modal-title(class="text-2xl font-extrabold text-slate-900 mb-3 tracking-tight") Finalisasi Draf?
        p(class="text-sm text-slate-500 leading-relaxed mb-5")
          | Apakah Anda yakin ingin memfinalisasi dan mengunci seluruh draf pengadaan ini?
          
        div(class="text-xs text-red-700 font-medium leading-relaxed bg-red-50/85 border border-red-100 p-4 rounded-2xl mb-7 text-center w-full")
          span(class="font-bold block mb-1 text-red-800") ⚠️ Tindakan Permanen!
          | Seluruh keputusan barang akan dikunci dan status menjadi APPROVED. Staf Administrasi akan langsung memproses barang. Tindakan ini tidak dapat dibatalkan!
          
        div(class="flex items-center justify-center gap-3 w-full")
          button(
            type="button" 
            id="btn-cancel-finalize"
            onclick="closeFinalizeModal()" 
            class="flex-1 py-3 bg-slate-100 hover:bg-slate-200 active:scale-98 text-slate-700 rounded-xl text-sm font-bold shadow-xs transition-all duration-200 cursor-pointer"
          ) Batalkan
          button(
            type="button" 
            id="btn-confirm-finalize"
            onclick="finalizeDraft()" 
            class="flex-1 py-3 bg-slate-900 hover:bg-green-600 active:scale-98 text-white rounded-xl text-sm font-bold shadow-md shadow-slate-900/10 hover:shadow-green-600/20 transition-all duration-200 cursor-pointer flex items-center justify-center gap-1.5"
          ) Ya, Finalisasikan!

  //- 2. Success Modal
  div#success-modal(class="hidden fixed inset-0 z-50 overflow-y-auto" aria-labelledby="success-title" role="dialog" aria-modal="true")
    //- Backdrop blur overlay
    div(class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm transition-all duration-300 animate-backdrop-fade" aria-hidden="true" onclick="closeSuccessModal()")
    
    //- Centered modal container
    div(class="fixed inset-0 z-50 flex items-center justify-center p-4")
      div(class="relative bg-white rounded-3xl text-center shadow-2xl border border-slate-100 p-6 md:p-8 max-w-md w-full animate-modal-enter flex flex-col items-center")
        //- Success Icon Animation
        div(class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-green-50 text-green-600 mb-5 border border-green-100 shadow-inner")
          svg(xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 animate-bounce mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7")
        
        h3#success-title(class="text-2xl font-extrabold text-slate-900 mb-3 tracking-tight") Berhasil Difinalisasi!
        p(class="text-sm text-slate-500 leading-relaxed mb-7")
          | Seluruh keputusan barang telah dikunci di database. Status pengadaan diubah menjadi <strong class="text-green-700 font-bold">DISETUJUI &amp; FINAL</strong>. Halaman ini sekarang dalam mode baca-saja (*read-only*).
        
        button(
          type="button" 
          onclick="closeSuccessModal()" 
          class="w-full py-3.5 bg-slate-900 hover:bg-green-600 active:scale-98 text-white rounded-xl text-sm font-bold shadow-md shadow-slate-900/10 hover:shadow-green-600/20 transition-all duration-300 cursor-pointer"
        ) Oke, Mengerti

  //- 3. Warning / Incomplete Modal
  div#warning-modal(class="hidden fixed inset-0 z-50 overflow-y-auto" aria-labelledby="warning-title" role="dialog" aria-modal="true")
    //- Backdrop blur overlay
    div(class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm transition-all duration-300 animate-backdrop-fade" aria-hidden="true" onclick="closeWarningModal()")
    
    //- Centered modal container
    div(class="fixed inset-0 z-50 flex items-center justify-center p-4")
      div(class="relative bg-white rounded-3xl text-center shadow-2xl border border-slate-100 p-6 md:p-8 max-w-md w-full animate-modal-enter flex flex-col items-center")
        //- Amber warning icon
        div(class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-orange-50 text-orange-500 mb-5 border border-orange-100 shadow-inner")
          svg(xmlns="http://www.w3.org/2000/svg" class="h-11 w-11 animate-pulse mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z")
        
        h3#warning-title(class="text-2xl font-extrabold text-slate-900 mb-3 tracking-tight") Ulasan Belum Lengkap!
        p(class="text-sm text-slate-500 leading-relaxed mb-7")
          | Anda memiliki <strong id="warning-pending-count" class="text-orange-600 font-extrabold">0</strong> barang yang belum diberi keputusan. Harap setujui atau tolak semua barang terlebih dahulu sebelum memfinalisasi draf ini.
        
        button(
          type="button" 
          onclick="closeWarningModal()" 
          class="w-full py-3.5 bg-slate-900 hover:bg-orange-600 active:scale-98 text-white rounded-xl text-sm font-bold shadow-md shadow-slate-900/10 hover:shadow-orange-600/20 transition-all duration-300 cursor-pointer"
        ) Lengkapi Ulasan Sekarang

  //- Interactive Client-Side JavaScript Logic
  script.
    // CSS Keyframe Injection for Micro-Animations
    const style = document.createElement('style');
    style.innerHTML = `
      @keyframes modalEnter {
        from { transform: scale(0.95); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
      }
      .animate-modal-enter {
        animation: modalEnter 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
      }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .animate-fade-in {
        animation: fadeIn 0.3s ease forwards;
      }
      @keyframes backdropFade {
        from { opacity: 0; backdrop-filter: blur(0px); }
        to { opacity: 1; backdrop-filter: blur(4px); }
      }
      .animate-backdrop-fade {
        animation: backdropFade 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
    `;
    document.head.appendChild(style);

    // Global elements
    const draftId = parseInt(document.getElementById('draft-container').dataset.draftId);
    let draftStatus = document.getElementById('draft-container').dataset.draftStatus;
    
    // Notification Toast Management
    function showNotification(text, type = 'success') {
      const banner = document.getElementById('notification-banner');
      const textElem = document.getElementById('notification-text');
      
      banner.classList.remove('hidden', 'bg-green-50', 'border-green-200', 'text-green-800', 'bg-red-50', 'border-red-200', 'text-red-800');
      
      if (type === 'success') {
        banner.classList.add('bg-green-50', 'border-green-200', 'text-green-800');
      } else {
        banner.classList.add('bg-red-50', 'border-red-200', 'text-red-800');
      }
      
      textElem.innerHTML = text;
      
      // Auto close after 6 seconds
      setTimeout(() => {
        closeNotification();
      }, 6000);
    }
    
    function closeNotification() {
      const banner = document.getElementById('notification-banner');
      banner.classList.add('hidden');
    }

    // Modal Confirmation Management
    function openFinalizeModal() {
      // Dynamic pending check
      const pending = parseInt(document.getElementById('pending-count-label').innerText);
      if (pending > 0) {
        document.getElementById('warning-pending-count').innerText = pending;
        openWarningModal();
      } else {
        document.getElementById('finalize-modal').classList.remove('hidden');
      }
    }
    
    function closeFinalizeModal() {
      document.getElementById('finalize-modal').classList.add('hidden');
    }

    function openSuccessModal() {
      document.getElementById('success-modal').classList.remove('hidden');
    }

    function closeSuccessModal() {
      document.getElementById('success-modal').classList.add('hidden');
    }

    function openWarningModal() {
      document.getElementById('warning-modal').classList.remove('hidden');
    }

    function closeWarningModal() {
      document.getElementById('warning-modal').classList.add('hidden');
    }

    // Update individual Item Decision Status
    async function decideItem(itemId, newStatus) {
      if (draftStatus === 'APPROVED') return; // Read-Only protection

      const row = document.getElementById(`item-row-${itemId}`);
      const btnApprove = row.querySelector('.btn-approve');
      const btnReject = row.querySelector('.btn-reject');
      const statusPill = row.querySelector('.status-pill');
      
      // Store original state for rollback
      const originalStatus = row.dataset.itemStatus;
      
      // Visual feedback loading state
      btnApprove.disabled = true;
      btnReject.disabled = true;
      statusPill.innerText = 'MEMPROSES...';

      try {
        const response = await fetch(`/api/procurements/items/${itemId}/status`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ status: newStatus })
        });
        
        if (response.ok) {
          // Success: Commit the new state in UI
          row.dataset.itemStatus = newStatus;
          updateVisualRowState(row, btnApprove, btnReject, statusPill, newStatus);
          recalculateStatsSummary();
          showNotification(`Berhasil menyetujui/menolak item: <strong>${row.querySelector('.font-semibold').innerText}</strong> menjadi <strong>${newStatus === 'APPROVED' ? 'DISETUJUI' : 'DITOLAK'}</strong>.`, 'success');
        } else {
          const resJson = await response.json();
          throw new Error(resJson.error || 'Terjadi kesalahan pada server');
        }
      } catch (err) {
        console.error('Decision update failed:', err);
        // Rollback visual state to original
        row.dataset.itemStatus = originalStatus;
        updateVisualRowState(row, btnApprove, btnReject, statusPill, originalStatus);
        
        // Show actual server error
        showNotification(`Gagal menyimpan keputusan: ${err.message}`, 'danger');
      } finally {
        btnApprove.disabled = false;
        btnReject.disabled = false;
      }
    }

    // Helper to update CSS states on decision row
    function updateVisualRowState(row, btnApprove, btnReject, statusPill, newStatus) {
      // 1. Reset buttons to default outline styles
      btnApprove.className = 'btn-approve px-3 py-1.5 rounded-lg text-xs font-bold tracking-wide border transition-all flex items-center gap-1 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed bg-white border-slate-200 text-slate-600 hover:border-green-300 hover:bg-green-50 hover:text-green-700';
      btnReject.className = 'btn-reject px-3 py-1.5 rounded-lg text-xs font-bold tracking-wide border transition-all flex items-center gap-1 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed bg-white border-slate-200 text-slate-600 hover:border-red-300 hover:bg-red-50 hover:text-red-700';

      // 2. Set active classes and badge
      if (newStatus === 'APPROVED') {
        btnApprove.className = 'btn-approve px-3 py-1.5 rounded-lg text-xs font-bold tracking-wide border transition-all flex items-center gap-1 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed bg-green-600 border-green-600 text-white shadow-sm shadow-green-600/20';
        statusPill.className = 'status-pill inline-flex justify-center w-32 items-center px-2.5 py-1 rounded-full text-xs font-semibold border transition-all bg-green-50 text-green-700 border-green-200';
        statusPill.innerText = 'DISETUJUI';
      } else if (newStatus === 'REJECTED') {
        btnReject.className = 'btn-reject px-3 py-1.5 rounded-lg text-xs font-bold tracking-wide border transition-all flex items-center gap-1 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed bg-red-600 border-red-600 text-white shadow-sm shadow-red-600/20';
        statusPill.className = 'status-pill inline-flex justify-center w-32 items-center px-2.5 py-1 rounded-full text-xs font-semibold border transition-all bg-red-50 text-red-700 border-red-200';
        statusPill.innerText = 'DITOLAK';
      } else {
        statusPill.className = 'status-pill inline-flex justify-center w-32 items-center px-2.5 py-1 rounded-full text-xs font-semibold border transition-all bg-amber-50 text-amber-700 border-amber-200';
        statusPill.innerText = 'PENDING';
      }
    }

    // Recalculate stats & enable/disable finalization button
    function recalculateStatsSummary() {
      const rows = document.querySelectorAll('#items-table tbody tr');
      if (rows.length === 0) return;

      let approved = 0;
      let rejected = 0;
      let pending = 0;

      rows.forEach(row => {
        const stat = row.dataset.itemStatus;
        if (stat === 'APPROVED') approved++;
        else if (stat === 'REJECTED') rejected++;
        else pending++;
      });

      // Update counters in HTML
      document.getElementById('approved-count-label').innerText = approved;
      document.getElementById('rejected-count-label').innerText = rejected;
      document.getElementById('pending-count-label').innerText = pending;

      // Update Progress Bar
      const total = rows.length;
      const appPct = (approved / total) * 100;
      const rejPct = (rejected / total) * 100;
      const penPct = (pending / total) * 100;

      document.getElementById('approved-bar').style.width = `${appPct}%`;
      document.getElementById('rejected-bar').style.left = `${appPct}%`;
      document.getElementById('rejected-bar').style.width = `${rejPct}%`;
      document.getElementById('pending-bar').style.left = `${appPct + rejPct}%`;
      document.getElementById('pending-bar').style.width = `${penPct}%`;

      // Keep button enabled, as we now handle warnings inside the modal dynamically!
      const btnFinalize = document.getElementById('btn-finalize-draft');
      if (btnFinalize) {
        if (draftStatus !== 'APPROVED') {
          btnFinalize.disabled = false;
        } else {
          btnFinalize.disabled = true;
        }
      }
    }

    // Finalize Draft - Change Status to APPROVED (Read-Only)
    async function finalizeDraft() {
      const btnConfirm = document.getElementById('btn-confirm-finalize');
      const btnCancel = document.getElementById('btn-cancel-finalize');
      const originalHtml = btnConfirm.innerHTML;
      
      // Disable both buttons to prevent multi-clicks
      btnConfirm.disabled = true;
      if (btnCancel) btnCancel.disabled = true;
      
      // SweetAlert style premium spinner loading state
      btnConfirm.innerHTML = `
        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Memproses...</span>
      `;

      try {
        const response = await fetch(`/api/procurements/${draftId}/status`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ status: 'APPROVED' })
        });

        if (response.ok) {
          // Close confirmation modal
          closeFinalizeModal();
          
          // Dynamic layout shift to read-only locally in real-time
          lockUILocally();
          
          // Open the gorgeous success overlay popup!
          openSuccessModal();
        } else {
          const resJson = await response.json();
          throw new Error(resJson.error || 'Gagal memfinalisasi draf di server');
        }
      } catch (err) {
        console.error('Finalization failed:', err);
        showNotification(`Gagal memfinalisasi draf: ${err.message}`, 'danger');
        
        // Restore buttons state
        btnConfirm.disabled = false;
        if (btnCancel) btnCancel.disabled = false;
        btnConfirm.innerHTML = originalHtml;
      }
    }

    // Lock entire UI locally to enter Read-Only State in real-time
    function lockUILocally() {
      draftStatus = 'APPROVED';
      document.getElementById('draft-container').dataset.draftStatus = 'APPROVED';
      
      // 1. Update draft status badge at the top
      const badge = document.getElementById('draft-status-badge');
      badge.className = 'inline-flex items-center px-3 py-1 rounded-full text-xs font-bold border transition-all bg-green-50 text-green-700 border-green-200';
      badge.innerText = 'DISETUJUI & FINAL';

      // 2. Insert locked read-only banner at the top
      const bannerContainer = document.querySelector('.flex.flex-wrap.items-center.justify-between.gap-4');
      if (!bannerContainer.querySelector('.bg-green-50')) {
        const lockedBanner = document.createElement('div');
        lockedBanner.className = 'flex items-center gap-2 bg-green-50 border border-green-200/80 px-4 py-2.5 rounded-2xl shadow-sm text-green-800 font-semibold text-sm animate-fade-in';
        lockedBanner.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></svg> Draf Terkunci (Read-Only)`;
        bannerContainer.appendChild(lockedBanner);
      }

      // 3. Disable all item approval/rejection buttons
      const buttons = document.querySelectorAll('.btn-decision-group button');
      buttons.forEach(btn => {
        btn.disabled = true;
      });

      // 4. Update the bottom finalization banner box
      const finBox = document.getElementById('finalization-box');
      if (finBox) {
        finBox.className = 'bg-white border p-6 rounded-2xl shadow-sm flex flex-col md:flex-row md:items-center md:justify-between gap-6 border-green-200 bg-green-50/10 transition-all';
        const finBtn = document.getElementById('btn-finalize-draft');
        if (finBtn) finBtn.disabled = true;
      }
    }
