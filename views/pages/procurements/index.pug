extends ../../layouts/crud_index.pug
include ../../components/forms/select.pug
include ../../components/forms/filter_bar.pug

block sidebar
  if sessionUser && sessionUser.userRole === 'ADMIN'
    include ../../components/sidebars/admin.pug
  else if sessionUser && sessionUser.userRole === 'KAPRODI'
    include ../../components/sidebars/kaprodi.pug
  else if sessionUser && sessionUser.userRole === 'KALAB'
    include ../../components/sidebars/kepala_lab.pug
  else if sessionUser && sessionUser.userRole === 'STAF_ADMIN'
    include ../../components/sidebars/staf_admin.pug
  else if sessionUser && sessionUser.userRole === 'STAF_LAB'
    include ../../components/sidebars/staf_lab.pug

block crud_title
  if selectedStatus === 'APPROVED'
    | Draf Pengadaan Final (Disetujui)
  else
    | Pengadaan Barang (Inventaris &amp; BHP)

block crud_subtitle
  if selectedStatus === 'APPROVED'
    | Daftar draf pengadaan tahunan yang telah disetujui dan difinalisasi.
  else
    | Kelola usulan draf pengadaan barang tahunan laboratorium.

block crud_search
  - const hasActiveFilters = selectedYear || selectedCreatedById || selectedItemType || (selectedStatus && selectedStatus !== 'APPROVED') || selectedSort !== 'latest'
  - const isAdvancedOpened = selectedYear || selectedCreatedById || selectedItemType || (selectedStatus && selectedStatus !== 'APPROVED')
  - const resetUrl = selectedStatus === 'APPROVED' ? "/procurements?status=APPROVED" : "/procurements"
  -
    const sortFilterOptions = [
      { value: 'latest', label: 'Terbaru' },
      { value: 'oldest', label: 'Terlama' },
      { value: 'names', label: 'Nama (A-Z)' },
      { value: 'status', label: 'Status' },
      { value: 'item_amount', label: 'Jumlah Barang' }
    ]
  - const gridCols = selectedStatus === 'APPROVED' ? 'grid-cols-1 sm:grid-cols-2 md:grid-cols-4' : 'grid-cols-1 sm:grid-cols-2 md:grid-cols-4'

  +filterBar("/procurements", "Cari draf pengadaan...", isAdvancedOpened, resetUrl, hasActiveFilters, sortFilterOptions, selectedSort || 'latest', gridCols)
    //- Year Filter
    -
      const yearOptions = [
        { value: '', label: 'Semua Tahun' },
        ...(yearsList || []).map(y => ({ value: String(y), label: String(y) }))
      ]
    div(class="space-y-1.5")
      label(class="text-xs font-semibold text-slate-500 uppercase tracking-wider") Tahun Pengadaan
      +selectField("year", "year", null, yearOptions, selectedYear || '', false, "py-2 pl-3 pr-10 bg-white min-w-full")

    //- Creator Filter
    -
      const creatorOptions = [
        { value: '', label: 'Semua Pengaju' },
        ...(creatorsList || []).map(c => ({ value: String(c.id), label: `${c.name} (${c.role.name})` }))
      ]
    div(class="space-y-1.5")
      label(class="text-xs font-semibold text-slate-500 uppercase tracking-wider") Diajukan Oleh
      +selectField("createdById", "createdById", null, creatorOptions, selectedCreatedById || '', false, "py-2 pl-3 pr-10 bg-white min-w-full")

    //- Item Type Filter
    -
      const itemTypeOptions = [
        { value: '', label: 'Semua Tipe Barang' },
        { value: 'INVENTORY', label: 'Hanya Inventaris (Aset)' },
        { value: 'BHP', label: 'Hanya BHP (Habis Pakai)' }
      ]
    div(class="space-y-1.5")
      label(class="text-xs font-semibold text-slate-500 uppercase tracking-wider") Tipe Barang
      +selectField("itemType", "itemType", null, itemTypeOptions, selectedItemType || '', false, "py-2 pl-3 pr-10 bg-white min-w-full")

    //- Status Filter
    if selectedStatus === 'APPROVED'
      input(type="hidden" name="status" value="APPROVED")
    else
      -
        const statusFilterOptions = [
          { value: '', label: 'Semua Status' },
          { value: 'DRAFT', label: 'DRAFT' },
          { value: 'PENDING_REVIEW', label: 'PENDING_REVIEW' },
          { value: 'APPROVED', label: 'COMPLETED (APPROVED)' }
        ]
      div(class="space-y-1.5")
        label(class="text-xs font-semibold text-slate-500 uppercase tracking-wider") Status Draf
        +selectField("status", "status", null, statusFilterOptions, selectedStatus || '', false, "py-2 pl-3 pr-10 bg-white min-w-full")


block crud_create_button
  if sessionUser && (sessionUser.userRole === 'ADMIN' || sessionUser.userRole === 'KALAB' || sessionUser.userRole === 'STAF_LAB')
    a(href="/procurements/new" class="inline-flex items-center justify-center bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-colors whitespace-nowrap")
      svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4")
      | Buat Pengajuan Baru

block crud_table_headers
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Judul Pengadaan
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Tahun
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Diajukan Oleh
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Jumlah Barang
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider") Status
  th(class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right") Aksi

block crud_table_rows
  if drafts && drafts.length > 0
    each draft in drafts
      tr(class="hover:bg-slate-50/50 transition-colors group")
        td(class="px-6 py-4 whitespace-nowrap")
          div(class="text-sm font-semibold text-slate-900")= draft.title
          div(class="text-xs text-slate-400") ID: ##{draft.id}
        td(class="px-6 py-4 whitespace-nowrap text-sm text-slate-600")= draft.year
        td(class="px-6 py-4 whitespace-nowrap text-sm text-slate-600")
          = draft.createdBy ? draft.createdBy.name : 'System'
        td(class="px-6 py-4 whitespace-nowrap text-sm text-slate-600")
          = draft.items ? draft.items.length : 0
          |  item
        td(class="px-6 py-4 whitespace-nowrap")
          if draft.status === 'DRAFT'
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-800 border border-slate-200") DRAFT
          else if draft.status === 'PENDING_REVIEW'
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-orange-100 text-orange-800 border border-orange-200") MENUNGGU REVIEW
          else if draft.status === 'APPROVED'
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200") COMPLETED
          else
            span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-800 border border-slate-200")= draft.status
        td(class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium")
          div(class="flex items-center justify-end space-x-2")
            // Action button based on role
            a(href=`/procurements/${draft.id}` class="text-green-600 hover:text-green-900 p-1.5 rounded-lg hover:bg-green-50 transition-colors flex items-center gap-1" title="Tinjau Detail")
              svg(xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z")
              span Tinjau
            
            // Edit/Delete for Creator / Staf Admin/Admin
            if sessionUser && (sessionUser.userRole === 'ADMIN' || draft.createdById === sessionUser.userId) && draft.status === 'DRAFT'
              a(href=`/procurements/${draft.id}/edit` class="text-blue-600 hover:text-blue-900 p-1.5 rounded-lg hover:bg-blue-50 transition-colors" title="Ubah")
                svg(xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z")
              form(action=`/procurements/${draft.id}?_method=DELETE` method="POST" class="inline-block" onsubmit="return confirm('Apakah Anda yakin ingin menghapus draf pengadaan ini? Semua item terkait akan ikut terhapus.');")
                button(type="submit" class="text-red-600 hover:text-red-900 p-1.5 rounded-lg hover:bg-red-50 transition-colors" title="Hapus")
                  svg(xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16")
  else
    tr
      td(colspan="6" class="px-6 py-8 text-center text-slate-500 bg-white")
        div(class="flex flex-col items-center justify-center space-y-2")
          svg(xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01")
          p Tidak ada draf pengadaan yang ditemukan.
