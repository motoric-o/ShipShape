// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime

  @@map("sessions")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique // e.g., 'ADMIN', 'KAPRODI', 'KALAB', 'STAF_ADMIN', 'STAF_LAB'
  description String?  @db.Text
  
  users       Users[]

  @@map("roles")
}

model Users {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])
  
  isActive  Boolean  @default(true)
  
  // Relations
  createdDrafts  ProcurementDraft[] @relation("DraftCreator")
  reviewedDrafts ProcurementDraft[] @relation("DraftReviewer")
  maintenances   MaintenanceLog[]   @relation("MaintenancePerformer")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
}

model Room {
  id          Int         @id @default(autoincrement())
  name        String
  description String?     @db.Text
  
  inventories Inventory[]
  bhps        BHP[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("rooms")
}

enum Condition {
  GOOD
  MAINTENANCE
  BROKEN
  DISPOSED
}

model Inventory {
  id              Int       @id @default(autoincrement())
  name            String
  labelNumber     String?   @unique
  qrCodePhotoPath String?
  condition       Condition @default(GOOD)
  
  roomId          Int
  room            Room      @relation(fields: [roomId], references: [id])
  
  // Replaced items in procurement
  replacements    ProcurementItem[] @relation("ReplacedInventory")
  
  maintenanceLogs MaintenanceLog[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("inventories")
}

model BHP {
  id          Int      @id @default(autoincrement())
  name        String
  stock       Int      @default(0)
  unit        String
  
  roomId      Int
  room        Room     @relation(fields: [roomId], references: [id])
  
  maintenanceUsages MaintenanceBHPUsage[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("bhps")
}

enum DraftStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
}

model ProcurementDraft {
  id          Int       @id @default(autoincrement())
  title       String
  year        Int
  status      DraftStatus @default(DRAFT)
  
  createdById Int
  createdBy   Users     @relation("DraftCreator", fields: [createdById], references: [id])
  
  reviewedById Int?
  reviewedBy   Users?   @relation("DraftReviewer", fields: [reviewedById], references: [id])

  items       ProcurementItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("procurement_drafts")
}

enum ItemType {
  INVENTORY
  BHP
}

enum ItemStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProcurementItem {
  id                  Int               @id @default(autoincrement())
  draftId             Int
  draft               ProcurementDraft  @relation(fields: [draftId], references: [id])
  
  type                ItemType
  name                String
  price               Float
  quantity            Int
  link                String?           @db.Text
  
  // Optional, if replacing an existing inventory item
  replacedInventoryId Int?
  replacedInventory   Inventory?        @relation("ReplacedInventory", fields: [replacedInventoryId], references: [id])

  status              ItemStatus        @default(PENDING)
  receiveDate         DateTime?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("procurement_items")
}

model MaintenanceLog {
  id             Int       @id @default(autoincrement())
  inventoryId    Int
  inventory      Inventory @relation(fields: [inventoryId], references: [id])
  
  maintenanceDate DateTime @default(now())
  description    String    @db.Text
  conditionAfter Condition
  
  performedById  Int
  performedBy    Users     @relation("MaintenancePerformer", fields: [performedById], references: [id])

  bhpUsages      MaintenanceBHPUsage[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("maintenance_logs")
}

model MaintenanceBHPUsage {
  id               Int            @id @default(autoincrement())
  maintenanceLogId Int
  maintenanceLog   MaintenanceLog @relation(fields: [maintenanceLogId], references: [id])
  
  bhpId            Int
  bhp              BHP            @relation(fields: [bhpId], references: [id])
  
  quantity         Int

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("maintenance_bhp_usages")
}
